<Window x:Class="ASO_PRODUCS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ASO_PRODUCS.Desktop.Controls"
        xmlns:views="clr-namespace:ASO_PRODUCS.Desktop.Views"
        mc:Ignorable="d"
        Title="ASO Producs"
        Icon="pack://application:,,,/Assets/Logo/aso-icon.ico"
        Height="800" Width="1280"
        MinHeight="640" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource AppFont}">

  <!-- Recarga manual. Las pantallas se actualizan solas tras cada escritura (ver
       Services/CambiosDeDatos.cs) y por eso ninguna barra trae ya un boton "Actualizar"; F5
       queda como red de seguridad. Se declara el gesto ademas del comando porque asi el atajo
       no depende de que el foco este en un control que herede el de NavigationCommands. -->
  <Window.CommandBindings>
    <CommandBinding Command="NavigationCommands.Refresh" Executed="OnRecargar" />
  </Window.CommandBindings>
  <Window.InputBindings>
    <KeyBinding Key="F5" Command="NavigationCommands.Refresh" />
  </Window.InputBindings>

  <!-- La escala de la interfaz es un LayoutTransform sobre la raiz, no un FontSize global:
       los estilos traen tamanos propios y subir solo la fuente descuadraria iconos, chips y
       columnas. Escalando el arbol entero todo crece a la vez. -->
  <Grid>
    <Grid.LayoutTransform>
      <ScaleTransform x:Name="EscalaInterfaz" ScaleX="1" ScaleY="1" />
    </Grid.LayoutTransform>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Barra superior.

         Antes la ocupaba un Menu con cuatro entradas (_Archivo, _Ver, _Herramientas, A_yuda)
         sin hijos, sin Click y sin Command: decoracion inerte en el sitio mas visible de la
         ventana. Ese espacio es ahora la ruta de la seccion abierta, que es lo unico que hacia
         falta y no estaba: donde estoy y como vuelvo. -->
    <!-- MinHeight: sin el, la barra crecia y encogia segun que chips estuvieran visibles, asi que
         entrar a una pantalla podia mover toda la interfaz un par de pixeles hacia abajo. -->
    <Border Grid.Row="0" Grid.ColumnSpan="2" MinHeight="44"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
            Padding="16,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <controls:Breadcrumb x:Name="Ruta" Grid.Column="0" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <!-- Saber en que organizacion se esta escribiendo importa antes de guardar nada.
               Colapsado si no hay ninguna activa (no debería pasar con sesión iniciada, pero
               fail-closed también aquí). -->
          <Border x:Name="OrganizacionChip" Style="{StaticResource ChipContextoStyle}"
                  Visibility="Collapsed">
            <TextBlock x:Name="OrganizacionActualLabel"
                       FontSize="{StaticResource FsMicro}"
                       FontWeight="{StaticResource FwMedium}" />
          </Border>

          <!-- Separador: quien eres y como sales son una cosa aparte del contexto de la
               izquierda, y sin nada que los agrupe la barra era una fila de trastos sueltos. -->
          <Border Width="1" Margin="4,0,12,0" VerticalAlignment="Stretch"
                  Background="{DynamicResource BorderBrush}" />

          <TextBlock x:Name="UsuarioActualLabel" VerticalAlignment="Center"
                     FontSize="{StaticResource FsCaption}"
                     Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0" />

          <Button Content="Cerrar sesión" Style="{StaticResource SecondaryButtonStyle}"
                  ToolTip="Salir de la sesión y volver al inicio de sesión"
                  Click="OnCerrarSesion" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Sidebar -->
    <controls:Sidebar x:Name="MainSidebar" Grid.Row="1" Grid.Column="0"
                      BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,1,0" />

    <!-- Contenido principal (cambia según la sección seleccionada).

         El ScrollViewer es del shell y no de cada pantalla: 36 de las 56 vistas no traen uno, y
         sin el, a escala 125 % con la ventana en su minimo (1024x640) el contenido se recortaba
         sin barra de desplazamiento y no habia forma de llegar a lo de abajo. Ponerlo aqui lo
         resuelve para todas a la vez.

         El desplazamiento horizontal va DESACTIVADO, y no es solo por quitar una barra: un
         ScrollViewer que puede desplazarse a lo ancho mide a su hijo con ancho INFINITO, y un
         DataGrid medido asi no puede repartir los anchos en estrella — los deja en su minimo.
         Esa era la causa de que "Finca" o "Lote · Tablon" se leyeran como dos letras incluso con
         la ventana ancha. Desactivado, el contenido se mide contra el ancho real de la ventana y
         las columnas se reparten. Lo que aun no quepa lo resuelve la tabla con su propia barra,
         dentro del recuadro y sin arrastrar la pantalla entera. -->
    <ScrollViewer Grid.Row="1" Grid.Column="1"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="20">
      <ContentControl x:Name="ContentArea" />
    </ScrollViewer>

  </Grid>
</Window>
