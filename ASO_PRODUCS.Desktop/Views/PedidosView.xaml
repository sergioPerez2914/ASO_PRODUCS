<UserControl x:Class="ASO_PRODUCS.Desktop.Views.PedidosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_PRODUCS.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">

  <Grid Style="{StaticResource PantallaPlenaStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0"
                         Titulo="{Binding Submodulo.Nombre}"
                         Descripcion="{Binding Submodulo.Descripcion}" />

    <!-- Ya no hay conmutador: el historial de despachos se fue a su propio submódulo (ver
         DespachosViewModel). Queda un solo padrón, así que el DataContext del sub-VM se pone
         en el contenedor y no hay que repetirlo. -->
    <Grid Grid.Row="1" Margin="0,16,0,0" DataContext="{Binding Pedidos}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource ToolbarStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <WrapPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
            <controls:SearchBox Width="280" Margin="0,0,12,0" VerticalAlignment="Center"
                                Texto="{Binding TextoBusqueda, Mode=TwoWay}" />

            <controls:FiltroDropdown Style="{StaticResource FiltroDropdownStyle}" SelectedIndex="0"
                                     Margin="0,0,12,0" VerticalAlignment="Center"
                                     Command="{Binding CambiarFiltroCommand}">
              <ComboBoxItem Content="Todos" />
              <ComboBoxItem Content="Pendientes" />
              <ComboBoxItem Content="Parciales" />
              <ComboBoxItem Content="Completados" />
              <ComboBoxItem Content="Anulados" />
            </controls:FiltroDropdown>
            <TextBlock Text="{Binding Conteo}" VerticalAlignment="Center"
                       FontSize="{StaticResource FsCaption}"
                       Foreground="{DynamicResource TextMutedBrush}" />
          </WrapPanel>

          <TextBlock Grid.Row="0" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                     Text="{Binding Resumen}" FontSize="{StaticResource FsBody}"
                     Foreground="{DynamicResource TextSecondaryBrush}" />

          <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                      Margin="0,12,0,0">
            <Button Content="Nuevo pedido" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding AgregarCommand}" />
            <Button Content="Despachar pedido" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding DespacharCommand}"
                    ToolTip="Abre el despacho ya lleno con lo que falta entregar de este pedido." />
            <Button Content="Imprimir" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ImprimirCommand}"
                    ToolTip="Saca el documento por la impresora, tal como se ve aquí." />
            <Button Content="Anular" Style="{StaticResource SecondaryButtonStyle}"
                    Foreground="{DynamicResource DangerTextBrush}"
                    Command="{Binding AnularCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <TextBlock Grid.Row="1" Text="Doble clic o Enter sobre una fila para ver el detalle completo del pedido."
                 Margin="0,12,0,4" FontSize="{StaticResource FsCaption}"
                 Foreground="{DynamicResource TextMutedBrush}" />

      <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}" Padding="0">
        <Grid>
          <DataGrid x:Name="TablaPedidos" Style="{StaticResource DataGridStyle}"
                    ItemsSource="{Binding ItemsView}"
                    SelectedItem="{Binding SelectedItem}"
                    controls:AbrirFila.Comando="{Binding VerDetalleCommand}">
            <DataGrid.Columns>
              <controls:ColumnaTexto Header="Nº" Binding="{Binding Numero}" Width="12*" MinWidth="90" />
              <controls:ColumnaTexto Header="Fecha" Binding="{Binding FechaTexto}" Width="10*" MinWidth="80" />
              <controls:ColumnaTexto Header="Cliente" Binding="{Binding ClienteNombre}" Width="24*" MinWidth="140" />
              <controls:ColumnaNumero Header="Total" Binding="{Binding TotalTexto}" Width="12*" MinWidth="90">
                <controls:ColumnaNumero.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="FontWeight" Value="{StaticResource FwMedium}" />
                  </Style>
                </controls:ColumnaNumero.ElementStyle>
              </controls:ColumnaNumero>
              <DataGridTemplateColumn Header="Estado" Width="120">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource ChipEstadoPedidoStyle}">
                      <TextBlock Text="{Binding EstadoMostrado}" FontSize="{StaticResource FsCaption}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <controls:EmptyState Icono="{x:Static controls:Iconos.Pedidos}"
                               Titulo="No hay pedidos registrados"
                               Detalle="Registra lo que pida un cliente; después usa &quot;Despachar pedido&quot; para entregarlo, en una vez o en partes."
                               Visibility="{Binding HasItems, ElementName=TablaPedidos, Converter={StaticResource SinItemsAVis}}" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
