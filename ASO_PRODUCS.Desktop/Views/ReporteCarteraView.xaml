<UserControl x:Class="ASO_PRODUCS.Desktop.Views.ReporteCarteraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_PRODUCS.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100">

  <Grid Style="{StaticResource PantallaPlenaStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0"
                         Titulo="{Binding Submodulo.Nombre}"
                         Descripcion="{Binding Submodulo.Descripcion}" />

    <Border Grid.Row="1" Style="{StaticResource ToolbarStyle}">
      <WrapPanel VerticalAlignment="Center">
        <TextBlock Text="Desde" VerticalAlignment="Center" Margin="0,0,8,0"
                   FontSize="{StaticResource FsCaption}"
                   Foreground="{DynamicResource TextMutedBrush}" />
        <DatePicker Width="130" VerticalAlignment="Center"
                    Style="{StaticResource FormDatePickerStyle}"
                    SelectedDate="{Binding FechaDesde}" />
        <TextBlock Text="hasta" VerticalAlignment="Center" Margin="8,0,8,0"
                   FontSize="{StaticResource FsCaption}"
                   Foreground="{DynamicResource TextMutedBrush}" />
        <DatePicker Width="130" VerticalAlignment="Center"
                    Style="{StaticResource FormDatePickerStyle}"
                    SelectedDate="{Binding FechaHasta}" />
        <Button Content="Exportar a Excel" Style="{StaticResource SecondaryButtonStyle}"
                Margin="16,0,0,0" Command="{Binding ExportarExcelCommand}" />
      </WrapPanel>
    </Border>

    <ItemsControl Grid.Row="2" ItemsSource="{Binding Indicadores}" Margin="0,16,0,0">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <controls:KpiTile Margin="0,0,12,12" MinWidth="180"
                            Etiqueta="{Binding Etiqueta}"
                            Valor="{Binding Valor}"
                            Nota="{Binding Nota}"
                            Estado="{Binding Estado}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4,0,0">
      <RadioButton Content="Por cliente (CxC)" GroupName="VistaReporteCartera"
                   Style="{StaticResource SegmentedTabStyle}"
                   IsChecked="{Binding EsPorCliente, Mode=TwoWay}" />
      <RadioButton Content="Por proveedor (CxP)" GroupName="VistaReporteCartera"
                   Style="{StaticResource SegmentedTabStyle}"
                   IsChecked="{Binding EsPorProveedor, Mode=TwoWay}" />
    </StackPanel>

    <Border Grid.Row="3" Style="{StaticResource TabStripStyle}" VerticalAlignment="Bottom" />

    <!-- ===================== Por cliente (CxC) ===================== -->
    <Grid Grid.Row="4" Margin="0,16,0,0"
          Visibility="{Binding MostrarPorCliente, Converter={StaticResource BoolToVis}}">
      <Border Style="{StaticResource SectionCardStyle}" Padding="0">
        <Grid>
          <DataGrid x:Name="TablaPorCliente" Style="{StaticResource DataGridStyle}"
                    ItemsSource="{Binding PorCliente}" IsReadOnly="True">
            <DataGrid.Columns>
              <controls:ColumnaTexto Header="Documento" Binding="{Binding Documento}" Width="16*" MinWidth="110" />
              <controls:ColumnaTexto Header="Cliente" Binding="{Binding Nombre}" Width="26*" MinWidth="160" />
              <controls:ColumnaTexto Header="Fecha emisión" Binding="{Binding FechaEmisionTexto}" Width="14*" MinWidth="100" />
              <controls:ColumnaTexto Header="Vencimiento" Binding="{Binding VencimientoTexto}" Width="14*" MinWidth="100" />
              <controls:ColumnaTexto Header="Estado" Binding="{Binding PlazoTexto}" Width="16*" MinWidth="130" />
              <controls:ColumnaNumero Header="Monto" Binding="{Binding MontoTexto}" Width="14*" MinWidth="100" />
            </DataGrid.Columns>
          </DataGrid>

          <controls:EmptyState Icono="{x:Static controls:Iconos.CuentasPorCobrar}"
                               Titulo="No hay saldos por cobrar en el período"
                               Detalle="Cambia el rango de fechas o registra facturas en Finanzas · Cuentas por Cobrar."
                               Visibility="{Binding HasItems, ElementName=TablaPorCliente, Converter={StaticResource SinItemsAVis}}" />
        </Grid>
      </Border>
    </Grid>

    <!-- ===================== Por proveedor (CxP) ===================== -->
    <Grid Grid.Row="4" Margin="0,16,0,0"
          Visibility="{Binding MostrarPorProveedor, Converter={StaticResource BoolToVis}}">
      <Border Style="{StaticResource SectionCardStyle}" Padding="0">
        <Grid>
          <DataGrid x:Name="TablaPorProveedor" Style="{StaticResource DataGridStyle}"
                    ItemsSource="{Binding PorProveedor}" IsReadOnly="True">
            <DataGrid.Columns>
              <controls:ColumnaTexto Header="Documento" Binding="{Binding Documento}" Width="16*" MinWidth="110" />
              <controls:ColumnaTexto Header="Proveedor" Binding="{Binding Nombre}" Width="26*" MinWidth="160" />
              <controls:ColumnaTexto Header="Fecha emisión" Binding="{Binding FechaEmisionTexto}" Width="14*" MinWidth="100" />
              <controls:ColumnaTexto Header="Vencimiento" Binding="{Binding VencimientoTexto}" Width="14*" MinWidth="100" />
              <controls:ColumnaTexto Header="Estado" Binding="{Binding PlazoTexto}" Width="16*" MinWidth="130" />
              <controls:ColumnaNumero Header="Monto" Binding="{Binding MontoTexto}" Width="14*" MinWidth="100" />
            </DataGrid.Columns>
          </DataGrid>

          <controls:EmptyState Icono="{x:Static controls:Iconos.CuentasPorPagar}"
                               Titulo="No hay saldos por pagar en el período"
                               Detalle="Cambia el rango de fechas o registra facturas en Finanzas · Cuentas por Pagar."
                               Visibility="{Binding HasItems, ElementName=TablaPorProveedor, Converter={StaticResource SinItemsAVis}}" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
