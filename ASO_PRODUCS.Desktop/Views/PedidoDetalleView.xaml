<UserControl x:Class="ASO_PRODUCS.Desktop.Views.PedidoDetalleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:ASO_PRODUCS.Desktop.Models"
             mc:Ignorable="d"
             d:DesignWidth="900">

  <!-- Ficha de solo lectura: encabezado con lo esencial y debajo el detalle de líneas, con lo
       pedido/despachado/pendiente de cada una. -->
  <StackPanel>

    <Border Style="{StaticResource SectionCardStyle}">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Text="{Binding Pedido.ClienteNombre}" Style="{StaticResource CardTitleStyle}" />
            <TextBlock FontSize="{StaticResource FsCaption}" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}">
              <Run Text="{Binding Pedido.Numero, Mode=OneWay}" />
              <Run Text=" · " />
              <Run Text="{Binding Pedido.FechaTexto, Mode=OneWay}" />
            </TextBlock>
          </StackPanel>

          <Border Grid.Column="1" Style="{StaticResource ChipEstadoPedidoStyle}"
                  DataContext="{Binding Pedido}" VerticalAlignment="Top">
            <TextBlock Text="{Binding EstadoMostrado}" FontSize="{StaticResource FsCaption}" />
          </Border>
        </Grid>

        <TextBlock Text="{Binding Pedido.Observaciones}" TextWrapping="Wrap" Margin="0,12,0,0"
                   FontSize="{StaticResource FsBody}" Foreground="{DynamicResource TextSecondaryBrush}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Pedido.Observaciones}" Value="">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </Border>

    <!-- Detalle del pedido -->
    <TextBlock Text="Detalle" Style="{StaticResource CardTitleStyle}" Margin="0,20,0,8" />

    <Border Style="{StaticResource SectionCardStyle}">
      <StackPanel Grid.IsSharedSizeScope="True">
        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" SharedSizeGroup="ColProductoPedido" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="ColPedidoPedido" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="ColDespachadoPedido" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="ColPendientePedido" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="ColSubtotalPedido" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Producto" FontWeight="{StaticResource FwMedium}" Margin="0,0,16,0" />
          <TextBlock Grid.Column="1" Text="Pedido" FontWeight="{StaticResource FwMedium}" Margin="0,0,16,0" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="2" Text="Despachado" FontWeight="{StaticResource FwMedium}" Margin="0,0,16,0" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="3" Text="Pendiente" FontWeight="{StaticResource FwMedium}" Margin="0,0,16,0" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="4" Text="Subtotal" FontWeight="{StaticResource FwMedium}" HorizontalAlignment="Right" />
        </Grid>
        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,4" />
        <ItemsControl ItemsSource="{Binding Pedido.Lineas}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" SharedSizeGroup="ColProductoPedido" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="ColPedidoPedido" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="ColDespachadoPedido" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="ColPendientePedido" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="ColSubtotalPedido" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding ProductoNombre}" Margin="0,0,16,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding CantidadPedidaTexto}" Margin="0,0,16,0" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2" Text="{Binding DespachadoTexto}" Margin="0,0,16,0" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Text="{Binding PendienteTexto}" Margin="0,0,16,0" HorizontalAlignment="Right">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding EstaCompleta}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="4" Text="{Binding SubtotalTexto}" HorizontalAlignment="Right" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4,0,4" />
        <TextBlock HorizontalAlignment="Right" FontWeight="{StaticResource FwMedium}"
                   Text="{Binding Pedido.TotalTexto, StringFormat='Total: {0}'}" />
      </StackPanel>
    </Border>

    <!-- Auditoría -->
    <Border Style="{StaticResource SectionCardStyle}" Margin="0,12,0,0">
      <StackPanel>
        <TextBlock FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource TextMutedBrush}">
          <Run Text="Creado por" />
          <Run Text="{Binding Pedido.CreadoPorNombre, Mode=OneWay}" />
          <Run Text=" · " />
          <Run Text="{Binding Pedido.FechaCreacion, Mode=OneWay, StringFormat=dd/MM/yyyy HH:mm}" />
        </TextBlock>

        <TextBlock FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"
                   TextWrapping="Wrap">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Pedido.Estado}" Value="{x:Static models:EstadoPedido.Anulado}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
          <Run Text="Anulado:" />
          <Run Text="{Binding Pedido.MotivoAnulacion, Mode=OneWay}" />
          <Run Text=" · " />
          <Run Text="{Binding Pedido.FechaAnulacion, Mode=OneWay, StringFormat=dd/MM/yyyy HH:mm}" />
        </TextBlock>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
