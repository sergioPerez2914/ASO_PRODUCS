<UserControl x:Class="ASO_PRODUCS.Desktop.Views.DespachoDetalleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:ASO_PRODUCS.Desktop.Models"
             mc:Ignorable="d"
             d:DesignWidth="900">

  <!-- Ficha de solo lectura: encabezado con lo esencial y debajo el detalle de líneas. -->
  <StackPanel>

    <Border Style="{StaticResource SectionCardStyle}">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock>
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource CardTitleStyle}">
                  <Setter Property="Text" Value="{Binding Despacho.ClienteNombre}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Despacho.ClienteNombre}" Value="">
                      <Setter Property="Text" Value="Ajuste" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock FontSize="{StaticResource FsCaption}" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}">
              <Run Text="{Binding Despacho.Numero, Mode=OneWay}" />
              <Run Text=" · " />
              <Run Text="{Binding Despacho.FechaTexto, Mode=OneWay}" />
              <Run Text=" · " />
              <Run Text="{Binding Despacho.TipoTexto, Mode=OneWay}" />
            </TextBlock>
          </StackPanel>

          <Border Grid.Column="1" Style="{StaticResource ChipEstadoDespachoStyle}"
                  DataContext="{Binding Despacho}" VerticalAlignment="Top">
            <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsCaption}" />
          </Border>
        </Grid>

        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Text="Monto" FontSize="{StaticResource FsCaption}"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{Binding Despacho.TotalTexto}" FontSize="{StaticResource FsBody}" />
          </StackPanel>

          <StackPanel Grid.Column="1">
            <TextBlock Text="Autoriza" FontSize="{StaticResource FsCaption}"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{Binding Despacho.AutorizadoPorNombre}" FontSize="{StaticResource FsBody}" />
          </StackPanel>
        </Grid>

        <TextBlock Text="{Binding Despacho.Observaciones}" TextWrapping="Wrap" Margin="0,12,0,0"
                   FontSize="{StaticResource FsBody}" Foreground="{DynamicResource TextSecondaryBrush}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Despacho.Observaciones}" Value="">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <TextBlock Text="{Binding Despacho.CuentaPorCobrarTexto, StringFormat='Cuenta por cobrar: {0}'}" Margin="0,8,0,0"
                   FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource TextMutedBrush}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Despacho.GeneraCuentaPorCobrar}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </Border>

    <!-- Detalle del despacho -->
    <TextBlock Text="Detalle" Style="{StaticResource CardTitleStyle}" Margin="{StaticResource TkTituloDeBloque}" />

    <Border Style="{StaticResource SectionCardStyle}">
      <StackPanel Grid.IsSharedSizeScope="True">
        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" SharedSizeGroup="ColProductoDespacho" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="ColCantidadDespacho" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="ColPrecioDespacho" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="ColSubtotalDespacho" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Producto" FontWeight="{StaticResource FwMedium}" Margin="0,0,16,0" />
          <TextBlock Grid.Column="1" Text="Cantidad" FontWeight="{StaticResource FwMedium}" Margin="0,0,16,0" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="2" Text="Precio" FontWeight="{StaticResource FwMedium}" Margin="0,0,16,0" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="3" Text="Subtotal" FontWeight="{StaticResource FwMedium}" HorizontalAlignment="Right" />
        </Grid>
        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,4" />
        <ItemsControl ItemsSource="{Binding Despacho.Lineas}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,4,0,4">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" SharedSizeGroup="ColProductoDespacho" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ColCantidadDespacho" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ColPrecioDespacho" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ColSubtotalDespacho" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding ProductoNombre}" Margin="0,0,16,0" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding CantidadTexto}" Margin="0,0,16,0" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="2" Text="{Binding PrecioUnitarioTexto}" Margin="0,0,16,0" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="3" Text="{Binding SubtotalTexto}" HorizontalAlignment="Right" />
                </Grid>
                <TextBlock Text="{Binding ProcesoOrigenTexto}" FontSize="{StaticResource FsCaption}"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="{StaticResource TkAyuda}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4,0,4" />
        <TextBlock HorizontalAlignment="Right" FontWeight="{StaticResource FwMedium}"
                   Text="{Binding Despacho.TotalTexto, StringFormat='Total: {0}'}" />
      </StackPanel>
    </Border>

    <!-- Auditoría -->
    <Border Style="{StaticResource SectionCardStyle}" Margin="0,12,0,0">
      <StackPanel>
        <TextBlock FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource TextMutedBrush}">
          <Run Text="Creado el" />
          <Run Text="{Binding Despacho.FechaCreacion, Mode=OneWay, StringFormat=dd/MM/yyyy HH:mm}" />
        </TextBlock>

        <TextBlock FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"
                   TextWrapping="Wrap">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Despacho.Estado}" Value="{x:Static models:EstadoDespacho.Anulado}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
          <Run Text="Anulado:" />
          <Run Text="{Binding Despacho.MotivoAnulacion, Mode=OneWay}" />
          <Run Text=" · " />
          <Run Text="{Binding Despacho.FechaAnulacion, Mode=OneWay, StringFormat=dd/MM/yyyy HH:mm}" />
        </TextBlock>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
