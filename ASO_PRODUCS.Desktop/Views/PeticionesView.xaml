<UserControl x:Class="ASO_PRODUCS.Desktop.Views.PeticionesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_PRODUCS.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">


  <Grid Style="{StaticResource PantallaPlenaStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0" Titulo="Peticiones de cambio"
                         Descripcion="{Binding ResumenPendientes}" />

    <!-- Barra de parámetros. Esta pantalla es la que dio la forma al resto, pero tenía las
         acciones arriba a la derecha; bajan a su fila para seguir el mismo orden que las demás.
         La nota va DEBAJO de las acciones y no en la columna del resumen: es un texto que se
         ajusta a varias líneas, no un contador corto. -->
    <Border Grid.Row="1" Style="{StaticResource ToolbarStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <WrapPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
          <controls:FiltroDropdown Style="{StaticResource FiltroDropdownStyle}" SelectedIndex="0"
                                   Margin="0,0,12,0" VerticalAlignment="Center"
                                   Command="{Binding CambiarFiltroCommand}">
            <ComboBoxItem Content="Pendientes" />
            <ComboBoxItem Content="Resueltas" />
            <ComboBoxItem Content="Todas" />
          </controls:FiltroDropdown>
        </WrapPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    Margin="0,12,0,0">
          <Button Content="Aprobar" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AprobarCommand}" />
          <Button Content="Rechazar" Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding RechazarCommand}" />
        </StackPanel>

        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,0"
                   Text="{Binding NotaAprobacion}" TextWrapping="Wrap" FontSize="{StaticResource FsCaption}"
                   Foreground="{DynamicResource TextMutedBrush}" />
      </Grid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}" Padding="0">
      <Grid>
        <DataGrid x:Name="Tabla" Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding PeticionesView}"
                  SelectedItem="{Binding Seleccionada}">
          <DataGrid.Columns>
            <controls:ColumnaTexto Header="Nº" Binding="{Binding Id}" Width="44" />
            <controls:ColumnaTexto Header="Solicitada" Width="13*" MinWidth="84"
                                   Binding="{Binding SolicitadoEn, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" />
            <controls:ColumnaTexto Header="Quién" Binding="{Binding SolicitadoPorNombre}" Width="15*" MinWidth="90" />
            <controls:ColumnaTexto Header="Acción" Binding="{Binding Accion}" Width="18*" MinWidth="100" />
            <controls:ColumnaTexto Header="Sobre" Binding="{Binding EntidadDescripcion}" Width="20*" MinWidth="100" />
            <controls:ColumnaTexto Header="Motivo" Binding="{Binding Motivo}" Width="20*" MinWidth="100" />
            <DataGridTemplateColumn Header="Estado" Width="92">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource ChipEstadoPeticionStyle}">
                    <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsCaption}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <controls:ColumnaTexto Header="Resuelta por" Binding="{Binding ResueltoPorNombre}" Width="15*" MinWidth="90" />
          </DataGrid.Columns>
        </DataGrid>

        <controls:EmptyState Icono="{x:Static controls:Iconos.Peticiones}"
                             Titulo="No hay peticiones que mostrar"
                             Detalle="Aquí llegan las solicitudes de cambio del personal de campo."
                             Visibility="{Binding HasItems, ElementName=Tabla, Converter={StaticResource SinItemsAVis}}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
