<UserControl x:Class="ASO_PRODUCS.Desktop.Views.TransformarLoteEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_PRODUCS.Desktop.Controls"
             xmlns:models="clr-namespace:ASO_PRODUCS.Desktop.Models"
             mc:Ignorable="d"
             d:DesignWidth="900">

  <UserControl.Resources>
    <!-- Las columnas del DataGrid no heredan DataContext; ver Controls/PuenteDeDatos.cs -->
    <controls:PuenteDeDatos x:Key="Puente" Datos="{Binding}" />
  </UserControl.Resources>

  <StackPanel>

    <TextBlock Text="Produce una presentación o subproducto a partir de un lote ya terminado. El consumo sale de la receta del producto y se descuenta al confirmar."
               FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}" />

    <!-- Paso 1: qué y cuánto -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>

      <controls:FormField Grid.Column="0" Etiqueta="Producto a obtener">
        <ComboBox Style="{StaticResource FormComboBoxStyle}"
                  ItemsSource="{Binding Productos}"
                  DisplayMemberPath="Nombre"
                  SelectedItem="{Binding ProductoSeleccionado}" />
      </controls:FormField>

      <controls:FormField Grid.Column="2" Etiqueta="Lote de origen"
                          Ayuda="Se propone el que vence primero. Si no alcanza, se completa con los siguientes.">
        <ComboBox Style="{StaticResource FormComboBoxStyle}"
                  ItemsSource="{Binding Lotes}"
                  DisplayMemberPath="Etiqueta"
                  SelectedItem="{Binding LoteSeleccionado}"
                  IsEnabled="{Binding HayLotes}" />
      </controls:FormField>

      <controls:FormField Grid.Column="4" Etiqueta="Cantidad a producir">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Grid.Column="0" Style="{StaticResource FormTextBoxStyle}" TextAlignment="Right"
                   Text="{Binding Unidades, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Grid.Column="1" Text="{Binding UnidadProducto}" Margin="8,0,0,0"
                     VerticalAlignment="Center" FontSize="{StaticResource FsBody}"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </Grid>
      </controls:FormField>
    </Grid>

    <TextBlock Text="{Binding RecetaTexto}" Margin="0,8,0,0" TextWrapping="Wrap"
               FontSize="{StaticResource FsCaption}"
               Foreground="{DynamicResource TextSecondaryBrush}" />

    <!-- AlertBoxStyle ya es exactamente esta caja (radio, relleno y borde); solo se le cambia el
         color, que es para lo que el estilo deja Background y BorderBrush sin fijar. Antes iba
         escrita a mano y era el unico CornerRadius literal que quedaba en toda la aplicacion. -->
    <Border Style="{StaticResource AlertBoxStyle}" Margin="0,12,0,0"
            Background="{DynamicResource WarningSoftBrush}"
            BorderBrush="{DynamicResource WarningBordeBrush}"
            Visibility="{Binding SinLotes, Converter={StaticResource BoolToVis}}">
      <TextBlock TextWrapping="Wrap" FontSize="{StaticResource FsBody}"
                 Foreground="{DynamicResource WarningTextBrush}"
                 Text="No hay lotes con existencia del producto base. Termine primero un proceso de ese producto en Producción." />
    </Border>

    <!-- Paso 2: vista previa del consumo -->
    <TextBlock Text="Se va a consumir" Style="{StaticResource CardTitleStyle}" Margin="{StaticResource TkTituloDeBloque}" />

    <Border Style="{StaticResource SectionCardStyle}" Padding="0">
      <Grid>
        <DataGrid x:Name="TablaConsumo" Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding Consumo}"
                  IsReadOnly="True" MaxHeight="240"
                  HeadersVisibility="Column" CanUserSortColumns="False">
          <DataGrid.Columns>
            <controls:ColumnaTexto Header="Material" Binding="{Binding MaterialNombre}" Width="30*" MinWidth="180" />
            <controls:ColumnaTexto Header="Origen" Binding="{Binding OrigenTexto}" Width="18*" MinWidth="120" />
            <controls:ColumnaNumero Header="Cantidad" Binding="{Binding CantidadTexto}" Width="16*" MinWidth="100" />
            <DataGridTemplateColumn Header="Existencia" Width="18*" MinWidth="130">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding DisponibleTexto}" HorizontalAlignment="Right" Margin="8,0"
                             VerticalAlignment="Center" FontSize="{StaticResource FsBody}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Alcanza}" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
                            <Setter Property="FontWeight" Value="{StaticResource FwMedium}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <TextBlock Text="Elija el producto y la cantidad para ver lo que se va a consumir."
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,48"
                   FontSize="{StaticResource FsBody}" Foreground="{DynamicResource TextMutedBrush}"
                   Visibility="{Binding HasItems, ElementName=TablaConsumo, Converter={StaticResource SinItemsAVis}}" />
      </Grid>
    </Border>

    <TextBlock Text="{Binding ResumenTexto}" Margin="0,8,0,0" TextWrapping="Wrap"
               FontSize="{StaticResource FsBody}" Foreground="{DynamicResource TextSecondaryBrush}" />

    <!-- Consumo adicional: merma o consumo no previsto en la receta de arriba. Misma grilla
         editable que "Iniciar proceso" (Views/IniciarProcesoEditorView.xaml); se funde con la
         receta al confirmar (TransformacionesService.Transformar → Fundir), así que agregar aquí
         el mismo material que ya trae la receta suma cantidad, no duplica línea. -->
    <TextBlock Text="Consumo adicional (opcional)" Style="{StaticResource CardTitleStyle}" Margin="{StaticResource TkTituloDeBloque}" />

    <Border Style="{StaticResource SectionCardStyle}" Padding="0">
      <Grid>
        <DataGrid x:Name="TablaLineasExtra" Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding LineasExtra}"
                  IsReadOnly="True"
                  MaxHeight="200"
                  HeadersVisibility="Column"
                  CanUserSortColumns="False">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Origen" Width="14*" MinWidth="110">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ComboBox Style="{StaticResource LineaComboBoxStyle}"
                            SelectedValuePath="Tag"
                            SelectedValue="{Binding OrigenSeleccionado, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBoxItem Content="Materia prima" Tag="{x:Static models:OrigenMaterial.MateriaPrima}" />
                    <ComboBoxItem Content="Inventario" Tag="{x:Static models:OrigenMaterial.Articulo}" />
                    <ComboBoxItem Content="Producto (lote)" Tag="{x:Static models:OrigenMaterial.Producto}" />
                  </ComboBox>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Material" Width="34*" MinWidth="220">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <!-- Tres ComboBox superpuestos: la visibilidad es un binding LOCAL a la fila
                       (EsMateriaPrima/EsArticulo/EsProducto), no necesita PuenteDeDatos. -->
                  <Grid>
                    <ComboBox Style="{StaticResource LineaComboBoxStyle}"
                              ItemsSource="{Binding TiposMateriaPrima}"
                              DisplayMemberPath="Nombre"
                              SelectedItem="{Binding TipoSeleccionado, UpdateSourceTrigger=PropertyChanged}"
                              Visibility="{Binding EsMateriaPrima, Converter={StaticResource BoolToVis}}" />
                    <ComboBox Style="{StaticResource LineaComboBoxStyle}"
                              ItemsSource="{Binding Articulos}"
                              DisplayMemberPath="Etiqueta"
                              SelectedItem="{Binding ArticuloSeleccionado, UpdateSourceTrigger=PropertyChanged}"
                              Visibility="{Binding EsArticulo, Converter={StaticResource BoolToVis}}" />
                    <ComboBox Style="{StaticResource LineaComboBoxStyle}"
                              ItemsSource="{Binding Lotes}"
                              DisplayMemberPath="EtiquetaConProducto"
                              SelectedItem="{Binding LoteSeleccionado, UpdateSourceTrigger=PropertyChanged}"
                              Visibility="{Binding EsProducto, Converter={StaticResource BoolToVis}}" />
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <controls:ColumnaTexto Header="Unidad" Binding="{Binding UnidadTexto}" Width="10*" MinWidth="70" />

            <DataGridTemplateColumn Header="Cantidad" Width="14*" MinWidth="100">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBox Style="{StaticResource LineaTextBoxStyle}" TextAlignment="Right"
                           Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Width="56">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Content="{x:Static controls:Iconos.Limpiar}"
                          Style="{StaticResource LineaBotonQuitarStyle}"
                          ToolTip="Quitar esta línea"
                          Command="{Binding Datos.QuitarLineaExtraCommand, Source={StaticResource Puente}}"
                          CommandParameter="{Binding}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <controls:EmptyState Compacto="True"
                             Icono="{x:Static controls:Iconos.Produccion}"
                             Titulo="Sin consumo adicional"
                             Detalle="Opcional: material extra por merma o consumo no previsto en la receta."
                             Visibility="{Binding HasItems, ElementName=TablaLineasExtra,
                                                  Converter={StaticResource SinItemsAVis}}" />
      </Grid>
    </Border>

    <Button Content="Agregar línea" Margin="0,8,0,0" HorizontalAlignment="Left"
            Style="{StaticResource SecondaryButtonStyle}"
            Command="{Binding AgregarLineaExtraCommand}" />

    <!-- Paso 3: cómo termina -->
    <CheckBox Content="Terminar ahora (sin etapas intermedias)" Margin="0,16,0,0" Cursor="Hand"
              Foreground="{DynamicResource TextPrimaryBrush}"
              IsChecked="{Binding TerminarAhora}"
              ToolTip="Desmárquelo si el subproducto necesita etapas (por ejemplo, clarificar y filtrar un ghee): el proceso quedará En proceso en Producción." />

    <Grid Margin="0,4,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>

      <controls:FormField Grid.Column="0" Etiqueta="Vence"
                          Ayuda="Propuesto con la vida útil del producto. Vacío si no vence."
                          Visibility="{Binding TerminarAhora, Converter={StaticResource BoolToVis}}">
        <DatePicker Style="{StaticResource FormDatePickerStyle}" SelectedDate="{Binding FechaVencimiento}" />
      </controls:FormField>

      <controls:FormField Grid.Column="2" Etiqueta="Observaciones">
        <TextBox Style="{StaticResource FormTextBoxStyle}"
                 Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}" />
      </controls:FormField>
    </Grid>
  </StackPanel>
</UserControl>
