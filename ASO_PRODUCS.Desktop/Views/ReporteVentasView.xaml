<UserControl x:Class="ASO_PRODUCS.Desktop.Views.ReporteVentasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_PRODUCS.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100">

  <Grid Style="{StaticResource PantallaPlenaStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0"
                         Titulo="{Binding Submodulo.Nombre}"
                         Descripcion="{Binding Submodulo.Descripcion}" />

    <Border Grid.Row="1" Style="{StaticResource ToolbarStyle}">
      <WrapPanel VerticalAlignment="Center">
        <TextBlock Text="Desde" VerticalAlignment="Center" Margin="0,0,8,0"
                   FontSize="{StaticResource FsCaption}"
                   Foreground="{DynamicResource TextMutedBrush}" />
        <DatePicker Width="130" VerticalAlignment="Center"
                    Style="{StaticResource FormDatePickerStyle}"
                    SelectedDate="{Binding FechaDesde}" />
        <TextBlock Text="hasta" VerticalAlignment="Center" Margin="8,0,8,0"
                   FontSize="{StaticResource FsCaption}"
                   Foreground="{DynamicResource TextMutedBrush}" />
        <DatePicker Width="130" VerticalAlignment="Center"
                    Style="{StaticResource FormDatePickerStyle}"
                    SelectedDate="{Binding FechaHasta}" />
        <Button Content="Exportar a Excel" Style="{StaticResource SecondaryButtonStyle}"
                Margin="16,0,0,0" Command="{Binding ExportarExcelCommand}" />
      </WrapPanel>
    </Border>

    <ItemsControl Grid.Row="2" ItemsSource="{Binding Indicadores}" Margin="0,16,0,0">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <controls:KpiTile Margin="0,0,12,12" MinWidth="180"
                            Etiqueta="{Binding Etiqueta}"
                            Valor="{Binding Valor}"
                            Nota="{Binding Nota}"
                            Estado="{Binding Estado}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Una sola tabla: no hace falta pestaña. -->
    <Border Grid.Row="3" Style="{StaticResource SectionCardStyle}" Padding="0" Margin="0,16,0,0">
      <Grid>
        <DataGrid x:Name="TablaDetalle" Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding Detalle}" IsReadOnly="True">
          <DataGrid.Columns>
            <controls:ColumnaTexto Header="Fecha" Binding="{Binding FechaTexto}" Width="12*" MinWidth="90" />
            <controls:ColumnaTexto Header="Despacho" Binding="{Binding DespachoNumero}" Width="14*" MinWidth="100" />
            <controls:ColumnaTexto Header="Cliente" Binding="{Binding ClienteNombre}" Width="22*" MinWidth="150" />
            <controls:ColumnaTexto Header="Producto" Binding="{Binding ProductoNombre}" Width="20*" MinWidth="150" />
            <controls:ColumnaNumero Header="Cantidad" Binding="{Binding CantidadTexto}" Width="14*" MinWidth="110" />
            <controls:ColumnaNumero Header="Precio unitario" Binding="{Binding PrecioUnitarioTexto}" Width="12*" MinWidth="100" />
            <controls:ColumnaNumero Header="Subtotal" Binding="{Binding SubtotalTexto}" Width="12*" MinWidth="100" />
          </DataGrid.Columns>
        </DataGrid>

        <controls:EmptyState Icono="{x:Static controls:Iconos.Despacho}"
                             Titulo="No hay ventas en el período"
                             Detalle="Cambia el rango de fechas o registra despachos tipo Venta en Procesos · Despacho."
                             Visibility="{Binding HasItems, ElementName=TablaDetalle, Converter={StaticResource SinItemsAVis}}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
