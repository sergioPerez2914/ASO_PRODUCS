<UserControl x:Class="ASO_PRODUCS.Desktop.Views.ReporteVentasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_PRODUCS.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100">

  <Grid Style="{StaticResource PantallaPlenaStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0"
                         Titulo="{Binding Submodulo.Nombre}"
                         Descripcion="{Binding Submodulo.Descripcion}" />

    <Border Grid.Row="1" Style="{StaticResource ToolbarStyle}">
      <WrapPanel VerticalAlignment="Center">
        <TextBlock Text="Desde" VerticalAlignment="Center" Margin="0,0,8,0"
                   FontSize="{StaticResource FsCaption}"
                   Foreground="{DynamicResource TextMutedBrush}" />
        <DatePicker Width="130" VerticalAlignment="Center"
                    Style="{StaticResource FormDatePickerStyle}"
                    SelectedDate="{Binding FechaDesde}" />
        <TextBlock Text="hasta" VerticalAlignment="Center" Margin="8,0,8,0"
                   FontSize="{StaticResource FsCaption}"
                   Foreground="{DynamicResource TextMutedBrush}" />
        <DatePicker Width="130" VerticalAlignment="Center"
                    Style="{StaticResource FormDatePickerStyle}"
                    SelectedDate="{Binding FechaHasta}" />
        <Button Content="Exportar a Excel" Style="{StaticResource SecondaryButtonStyle}"
                Margin="16,0,0,0" Command="{Binding ExportarExcelCommand}" />
      </WrapPanel>
    </Border>

    <ItemsControl Grid.Row="2" ItemsSource="{Binding Indicadores}" Margin="0,16,0,0">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <controls:KpiTile Margin="0,0,12,12" MinWidth="180"
                            Etiqueta="{Binding Etiqueta}"
                            Valor="{Binding Valor}"
                            Nota="{Binding Nota}"
                            Estado="{Binding Estado}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4,0,0">
      <RadioButton Content="Por producto" GroupName="VistaReporteVentas"
                   Style="{StaticResource SegmentedTabStyle}"
                   IsChecked="{Binding EsPorProducto, Mode=TwoWay}" />
      <RadioButton Content="Por cliente" GroupName="VistaReporteVentas"
                   Style="{StaticResource SegmentedTabStyle}"
                   IsChecked="{Binding EsPorCliente, Mode=TwoWay}" />
      <RadioButton Content="Detalle" GroupName="VistaReporteVentas"
                   Style="{StaticResource SegmentedTabStyle}"
                   IsChecked="{Binding EsDetalle, Mode=TwoWay}" />
    </StackPanel>

    <Border Grid.Row="3" Style="{StaticResource TabStripStyle}" VerticalAlignment="Bottom" />

    <!-- ===================== Por producto ===================== -->
    <Grid Grid.Row="4" Margin="0,16,0,0"
          Visibility="{Binding MostrarPorProducto, Converter={StaticResource BoolToVis}}">
      <Border Style="{StaticResource SectionCardStyle}" Padding="0">
        <Grid>
          <DataGrid x:Name="TablaPorProducto" Style="{StaticResource DataGridStyle}"
                    ItemsSource="{Binding PorProducto}" IsReadOnly="True">
            <DataGrid.Columns>
              <controls:ColumnaTexto Header="Producto" Binding="{Binding ProductoNombre}" Width="40*" MinWidth="180" />
              <controls:ColumnaNumero Header="Cantidad" Binding="{Binding CantidadTexto}" Width="30*" MinWidth="110" />
              <controls:ColumnaNumero Header="Monto" Binding="{Binding MontoTexto}" Width="30*" MinWidth="110" />
            </DataGrid.Columns>
          </DataGrid>

          <controls:EmptyState Icono="{x:Static controls:Iconos.Despacho}"
                               Titulo="No hay ventas en el período"
                               Detalle="Cambia el rango de fechas o registra despachos tipo Venta en Procesos · Despacho."
                               Visibility="{Binding HasItems, ElementName=TablaPorProducto, Converter={StaticResource SinItemsAVis}}" />
        </Grid>
      </Border>
    </Grid>

    <!-- ===================== Por cliente ===================== -->
    <Grid Grid.Row="4" Margin="0,16,0,0"
          Visibility="{Binding MostrarPorCliente, Converter={StaticResource BoolToVis}}">
      <Border Style="{StaticResource SectionCardStyle}" Padding="0">
        <Grid>
          <DataGrid x:Name="TablaPorCliente" Style="{StaticResource DataGridStyle}"
                    ItemsSource="{Binding PorCliente}" IsReadOnly="True">
            <DataGrid.Columns>
              <controls:ColumnaTexto Header="Cliente" Binding="{Binding ClienteNombre}" Width="40*" MinWidth="180" />
              <controls:ColumnaNumero Header="Despachos" Binding="{Binding CantidadDespachos}" Width="20*" MinWidth="90" />
              <controls:ColumnaNumero Header="Monto" Binding="{Binding MontoTexto}" Width="30*" MinWidth="110" />
            </DataGrid.Columns>
          </DataGrid>

          <controls:EmptyState Icono="{x:Static controls:Iconos.Cliente}"
                               Titulo="No hay ventas en el período"
                               Detalle="Cambia el rango de fechas o registra despachos tipo Venta en Procesos · Despacho."
                               Visibility="{Binding HasItems, ElementName=TablaPorCliente, Converter={StaticResource SinItemsAVis}}" />
        </Grid>
      </Border>
    </Grid>

    <!-- ===================== Detalle ===================== -->
    <Grid Grid.Row="4" Margin="0,16,0,0"
          Visibility="{Binding MostrarDetalle, Converter={StaticResource BoolToVis}}">
      <Border Style="{StaticResource SectionCardStyle}" Padding="0">
        <Grid>
          <DataGrid x:Name="TablaDetalle" Style="{StaticResource DataGridStyle}"
                    ItemsSource="{Binding Detalle}" IsReadOnly="True">
            <DataGrid.Columns>
              <controls:ColumnaTexto Header="Fecha" Binding="{Binding FechaTexto}" Width="12*" MinWidth="90" />
              <controls:ColumnaTexto Header="Despacho" Binding="{Binding DespachoNumero}" Width="14*" MinWidth="100" />
              <controls:ColumnaTexto Header="Cliente" Binding="{Binding ClienteNombre}" Width="20*" MinWidth="140" />
              <controls:ColumnaTexto Header="Producto" Binding="{Binding ProductoNombre}" Width="18*" MinWidth="140" />
              <controls:ColumnaNumero Header="Cantidad" Binding="{Binding CantidadTexto}" Width="14*" MinWidth="110" />
              <controls:ColumnaNumero Header="Precio unitario" Binding="{Binding PrecioUnitarioTexto}" Width="12*" MinWidth="100" />
              <controls:ColumnaNumero Header="Subtotal" Binding="{Binding SubtotalTexto}" Width="12*" MinWidth="100" />
              <controls:ColumnaTexto Header="Proceso de origen" Binding="{Binding ProcesoOrigenTexto}" Width="16*" MinWidth="140" />
            </DataGrid.Columns>
          </DataGrid>

          <controls:EmptyState Icono="{x:Static controls:Iconos.Despacho}"
                               Titulo="No hay ventas en el período"
                               Detalle="Cambia el rango de fechas o registra despachos tipo Venta en Procesos · Despacho."
                               Visibility="{Binding HasItems, ElementName=TablaDetalle, Converter={StaticResource SinItemsAVis}}" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
