<UserControl x:Class="ASO_PRODUCS.Desktop.Views.MovimientoBancoEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_PRODUCS.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="460">

  <StackPanel>
    <!-- Entrada/salida como par de opciones y no como desplegable: es lo que más cambia el
         significado del formulario, y conviene verlo sin abrir nada. -->
    <controls:FormField Etiqueta="Sentido">
      <StackPanel Orientation="Horizontal">
        <RadioButton Content="Salida" GroupName="SentidoMovimiento"
                     Style="{StaticResource SegmentedTabStyle}"
                     IsChecked="{Binding EsSalida, Mode=TwoWay}" />
        <RadioButton Content="Entrada" GroupName="SentidoMovimiento"
                     Style="{StaticResource SegmentedTabStyle}"
                     IsChecked="{Binding EsEntrada, Mode=TwoWay}" />
      </StackPanel>
    </controls:FormField>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <controls:FormField Etiqueta="Cuenta">
          <ComboBox Style="{StaticResource FormComboBoxStyle}"
                    ItemsSource="{Binding Cuentas}"
                    DisplayMemberPath="NombreConMoneda"
                    SelectedItem="{Binding CuentaSeleccionada}" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <controls:FormField Etiqueta="Monto">
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding Monto, UpdateSourceTrigger=PropertyChanged}" />
        </controls:FormField>
      </StackPanel>
    </Grid>

    <controls:FormField Etiqueta="Concepto">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               Text="{Binding Concepto, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="Qué fue: comisión del banco, retiro, aporte" />
    </controls:FormField>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <controls:FormField Etiqueta="Categoría">
          <ComboBox Style="{StaticResource FormComboBoxStyle}"
                    ItemsSource="{Binding Categorias}"
                    SelectedItem="{Binding CategoriaSeleccionada}" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <controls:FormField Etiqueta="Fecha valor">
          <DatePicker Style="{StaticResource FormDatePickerStyle}"
                      SelectedDate="{Binding Fecha}" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="4">
        <controls:FormField Etiqueta="Referencia">
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding Referencia, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Nº de transferencia, cheque o depósito" />
        </controls:FormField>
      </StackPanel>
    </Grid>

    <TextBlock TextWrapping="Wrap" FontSize="{StaticResource FsCaption}" Margin="0,8,0,0"
               Foreground="{DynamicResource TextMutedBrush}"
               Text="Aquí solo se registra lo que no viene de ningún documento. Un cobro o un pago se registran desde su factura y bajan solos al libro: tecleárlos otra vez contaría el mismo dinero dos veces." />
  </StackPanel>
</UserControl>
