<UserControl x:Class="ASO_PRODUCS.Desktop.Views.RecepcionMateriaPrimaEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_PRODUCS.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="900">

  <UserControl.Resources>
    <!-- Las columnas del DataGrid no heredan DataContext; ver Controls/PuenteDeDatos.cs -->
    <controls:PuenteDeDatos x:Key="Puente" Datos="{Binding}" />
  </UserControl.Resources>

  <StackPanel>

    <!-- Los tres modos. Pestañas y no pastillas: las pastillas son el estilo de los filtros. -->
    <StackPanel Orientation="Horizontal">
      <RadioButton Content="Compra a proveedor" GroupName="TipoRecepcionMateriaPrima"
                   Style="{StaticResource SegmentedTabStyle}"
                   IsChecked="{Binding EsCompraProveedor, Mode=TwoWay}" />
      <RadioButton Content="Compra externa" GroupName="TipoRecepcionMateriaPrima"
                   Style="{StaticResource SegmentedTabStyle}"
                   IsChecked="{Binding EsCompraExterna, Mode=TwoWay}" />
      <RadioButton Content="Otro origen" GroupName="TipoRecepcionMateriaPrima"
                   Style="{StaticResource SegmentedTabStyle}"
                   IsChecked="{Binding EsOtroOrigen, Mode=TwoWay}" />
    </StackPanel>

    <Border Style="{StaticResource TabStripStyle}" />

    <TextBlock Text="{Binding NotaModo}" Margin="0,12,0,0" TextWrapping="Wrap"
               FontSize="{StaticResource FsCaption}"
               Foreground="{DynamicResource TextMutedBrush}" />

    <!-- Cabecera: compra a proveedor -->
    <controls:FormField Etiqueta="Proveedor"
                        Visibility="{Binding MuestraProveedor, Converter={StaticResource BoolToVis}}">
      <ComboBox Style="{StaticResource FormComboBoxStyle}"
                ItemsSource="{Binding Proveedores}"
                DisplayMemberPath="Etiqueta"
                SelectedItem="{Binding ProveedorSeleccionado}" />
    </controls:FormField>

    <!-- Cabecera: compra externa -->
    <Grid Visibility="{Binding MuestraComercio, Converter={StaticResource BoolToVis}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <controls:FormField Etiqueta="Proveedor"
                            Ayuda="Si no está en el padrón de proveedores se dará de alta solo.">
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding Comercio, UpdateSourceTrigger=PropertyChanged}" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <controls:FormField Etiqueta="Gestionado por">
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding RecibidoPor, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Quién de la empresa gestionó la compra" />
        </controls:FormField>
      </StackPanel>
    </Grid>

    <!-- Papel y plazo: solo cuando hay algo que deber -->
    <Grid Visibility="{Binding MuestraPrecios, Converter={StaticResource BoolToVis}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <controls:FormField Etiqueta="Nº de factura o recibo">
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding NumeroDocumento, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="El número que trae el papel del proveedor" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <controls:FormField Etiqueta="Fecha de la compra">
          <DatePicker Style="{StaticResource FormDatePickerStyle}"
                      SelectedDate="{Binding Fecha}" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="4">
        <controls:FormField Etiqueta="Vencimiento del pago">
          <DatePicker Style="{StaticResource FormDatePickerStyle}"
                      SelectedDate="{Binding FechaVencimiento}" />
        </controls:FormField>
      </StackPanel>
    </Grid>

    <!-- Otro origen solo necesita la fecha -->
    <controls:FormField Etiqueta="Fecha de la recepción"
                        Visibility="{Binding EsOtroOrigen, Converter={StaticResource BoolToVis}}">
      <DatePicker Style="{StaticResource FormDatePickerStyle}"
                  SelectedDate="{Binding Fecha}" />
    </controls:FormField>

    <controls:FormField Etiqueta="Referencia" Ayuda="Guía, remito u orden de quien entrega.">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               Text="{Binding Referencia, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>

    <!-- Tipos de materia prima que llegan -->
    <TextBlock Text="Materia prima que llega" Style="{StaticResource CardTitleStyle}" Margin="0,20,0,8" />

    <Border Style="{StaticResource SectionCardStyle}" Padding="0">
      <DataGrid Style="{StaticResource DataGridStyle}"
                ItemsSource="{Binding Lineas}"
                IsReadOnly="True"
                MaxHeight="260"
                HeadersVisibility="Column"
                CanUserSortColumns="False">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="Tipo" Width="30*" MinWidth="180">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ComboBox Style="{StaticResource LineaComboBoxStyle}"
                          ItemsSource="{Binding Tipos}"
                          DisplayMemberPath="Nombre"
                          SelectedItem="{Binding TipoSeleccionado, UpdateSourceTrigger=PropertyChanged}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <controls:ColumnaNumero Header="Existencia" Binding="{Binding ExistenciaTexto}" Width="14*" MinWidth="90" />

          <DataGridTemplateColumn Header="Cantidad" Width="14*" MinWidth="100">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBox Style="{StaticResource LineaTextBoxStyle}" TextAlignment="Right"
                         Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTemplateColumn Header="Precio" Width="14*" MinWidth="90"
                                  Visibility="{Binding Datos.MuestraPrecios, Source={StaticResource Puente},
                                                       Converter={StaticResource BoolToVis}}">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBox Style="{StaticResource LineaTextBoxStyle}" TextAlignment="Right"
                         Text="{Binding PrecioUnitario, UpdateSourceTrigger=PropertyChanged}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <controls:ColumnaNumero Header="Subtotal" Binding="{Binding SubtotalTexto}" Width="14*" MinWidth="90"
                                  Visibility="{Binding Datos.MuestraPrecios, Source={StaticResource Puente},
                                                       Converter={StaticResource BoolToVis}}" />

          <DataGridTemplateColumn Width="56">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Content="{x:Static controls:Iconos.Limpiar}"
                        Style="{StaticResource LineaBotonQuitarStyle}"
                        ToolTip="Quitar esta línea"
                        Command="{Binding Datos.QuitarLineaCommand, Source={StaticResource Puente}}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Button Grid.Column="0" Content="Agregar línea" Margin="0"
              Style="{StaticResource SecondaryButtonStyle}"
              Command="{Binding AgregarLineaCommand}" />

      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                  Visibility="{Binding MuestraPrecios, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="Total" VerticalAlignment="Center" Margin="0,0,12,0"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBlock Text="{Binding TotalTexto}" Style="{StaticResource FormValorCalculadoStyle}" />
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                  Visibility="{Binding EsOtroOrigen, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="Total" VerticalAlignment="Center" Margin="0,0,12,0"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBlock Text="{Binding TotalCantidad, StringFormat=N2}" Style="{StaticResource FormValorCalculadoStyle}" />
      </StackPanel>
    </Grid>

    <controls:FormField Etiqueta="Observaciones">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               AcceptsReturn="True" MinLines="2" TextWrapping="Wrap"
               VerticalContentAlignment="Top"
               Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>
  </StackPanel>
</UserControl>
