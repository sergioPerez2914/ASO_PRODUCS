<UserControl x:Class="ASO_PRODUCS.Desktop.Views.RecepcionesMateriaPrimaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_PRODUCS.Desktop.Controls"
             xmlns:models="clr-namespace:ASO_PRODUCS.Desktop.Models"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">

  <UserControl.Resources>
    <!-- Detalle de la recepción como ToolTip de fila, mismo patrón que Entradas de almacén. -->
    <DataTemplate DataType="{x:Type models:RecepcionMateriaPrima}">
      <StackPanel Grid.IsSharedSizeScope="True" MaxWidth="420">
        <TextBlock Text="{Binding Referencia, StringFormat='Referencia: {0}'}" Margin="0,0,0,8" />
        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" SharedSizeGroup="ColTipoRecepcion" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="ColCantidadRecepcion" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Tipo" FontWeight="{StaticResource FwMedium}" Margin="0,0,16,0" />
          <TextBlock Grid.Column="1" Text="Cantidad" FontWeight="{StaticResource FwMedium}" HorizontalAlignment="Right" />
        </Grid>
        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,4" />
        <ItemsControl ItemsSource="{Binding Lineas}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" SharedSizeGroup="ColTipoRecepcion" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="ColCantidadRecepcion" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding TipoMateriaPrimaNombre}" Margin="0,0,16,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding CantidadTexto}" HorizontalAlignment="Right" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Style="{StaticResource PantallaPlenaStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0"
                         Titulo="{Binding Submodulo.Nombre}"
                         Descripcion="{Binding Submodulo.Descripcion}" />

    <Grid Grid.Row="1" Margin="0,16,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource ToolbarStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <WrapPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
            <controls:SearchBox Width="280" Margin="0,0,12,0" VerticalAlignment="Center"
                                Texto="{Binding TextoBusqueda, Mode=TwoWay}" />

            <controls:FiltroDropdown Style="{StaticResource FiltroDropdownStyle}" SelectedIndex="0"
                                     Margin="0,0,12,0" VerticalAlignment="Center"
                                     Command="{Binding CambiarFiltroCommand}">
              <ComboBoxItem Content="Todas" />
              <ComboBoxItem Content="Anuladas" />
            </controls:FiltroDropdown>
          </WrapPanel>

          <TextBlock Grid.Row="0" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                     Text="{Binding Resumen}" FontSize="{StaticResource FsBody}"
                     Foreground="{DynamicResource TextSecondaryBrush}" />

          <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                      Margin="0,12,0,0">
            <Button Content="Registrar recepción" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding AgregarCommand}" />
            <Button Content="Anular" Style="{StaticResource SecondaryButtonStyle}"
                    Foreground="{DynamicResource DangerTextBrush}"
                    Command="{Binding AnularCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Padding="0">
        <Grid>
          <DataGrid x:Name="TablaRecepciones" Style="{StaticResource DataGridStyle}"
                    ItemsSource="{Binding ItemsView}"
                    SelectedItem="{Binding SelectedItem}">
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                <Setter Property="ToolTip" Value="{Binding}" />
                <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <controls:ColumnaTexto Header="Nº" Binding="{Binding Numero}" Width="12*" MinWidth="86" />
              <controls:ColumnaTexto Header="Fecha" Binding="{Binding FechaTexto}" Width="10*" MinWidth="78" />
              <controls:ColumnaTexto Header="Referencia" Binding="{Binding Referencia}" Width="20*" MinWidth="120" />
              <controls:ColumnaNumero Header="Líneas" Binding="{Binding CantidadLineas}" Width="9*" MinWidth="60" />
              <controls:ColumnaNumero Header="Total" Binding="{Binding TotalCantidad, StringFormat=N2}" Width="12*" MinWidth="86" />
              <DataGridTemplateColumn Header="Estado" Width="96">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource ChipEstadoRecepcionMateriaPrimaStyle}">
                      <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsCaption}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <controls:EmptyState Icono="{x:Static controls:Iconos.Entradas}"
                               Titulo="No hay recepciones registradas"
                               Detalle="Registra la primera recepción cuando llegue materia prima nueva."
                               Visibility="{Binding HasItems, ElementName=TablaRecepciones, Converter={StaticResource SinItemsAVis}}" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
