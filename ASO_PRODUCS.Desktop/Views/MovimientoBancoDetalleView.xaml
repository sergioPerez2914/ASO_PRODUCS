<UserControl x:Class="ASO_PRODUCS.Desktop.Views.MovimientoBancoDetalleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:ASO_PRODUCS.Desktop.Models"
             mc:Ignorable="d"
             d:DesignWidth="640">

  <!-- Ficha de solo lectura de un asiento plano: sin historial de líneas, todo cabe en el encabezado. -->
  <StackPanel>

    <Border Style="{StaticResource SectionCardStyle}">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Text="{Binding Movimiento.Concepto}" Style="{StaticResource CardTitleStyle}" />
            <TextBlock FontSize="{StaticResource FsCaption}" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}">
              <Run Text="{Binding Movimiento.FechaTexto, Mode=OneWay}" />
              <Run Text=" · " />
              <Run Text="{Binding Movimiento.CuentaNombre, Mode=OneWay}" />
            </TextBlock>
          </StackPanel>

          <Border Grid.Column="1" Style="{StaticResource ChipEstadoMovimientoBancoStyle}"
                  DataContext="{Binding Movimiento}" VerticalAlignment="Top">
            <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsCaption}" />
          </Border>
        </Grid>

        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Text="{Binding Movimiento.TipoTexto}" FontSize="{StaticResource FsCaption}"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{Binding Movimiento.MontoTexto}" FontSize="{StaticResource FsBody}" />
          </StackPanel>

          <StackPanel Grid.Column="1">
            <TextBlock Text="Categoría" FontSize="{StaticResource FsCaption}"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{Binding Movimiento.CategoriaTexto}" FontSize="{StaticResource FsBody}" />
          </StackPanel>

          <StackPanel Grid.Column="2">
            <TextBlock Text="Origen" FontSize="{StaticResource FsCaption}"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{Binding Movimiento.OrigenTexto}" FontSize="{StaticResource FsBody}" />
            <TextBlock Text="{Binding Movimiento.DocumentoTexto}" FontSize="{StaticResource FsCaption}"
                       Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
        </Grid>

        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Text="Referencia" FontSize="{StaticResource FsCaption}"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{Binding Movimiento.Referencia}" FontSize="{StaticResource FsBody}" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Grid.Column="1">
            <TextBlock Text="Conciliación" FontSize="{StaticResource FsCaption}"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{Binding Movimiento.ConciliacionTexto}" FontSize="{StaticResource FsBody}" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Auditoría -->
    <Border Style="{StaticResource SectionCardStyle}" Margin="0,12,0,0">
      <StackPanel>
        <TextBlock FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource TextMutedBrush}">
          <Run Text="Creado el" />
          <Run Text="{Binding Movimiento.FechaCreacion, Mode=OneWay, StringFormat=dd/MM/yyyy HH:mm}" />
        </TextBlock>

        <TextBlock FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"
                   TextWrapping="Wrap">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Movimiento.Estado}" Value="{x:Static models:EstadoMovimientoBanco.Anulado}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
          <Run Text="Anulado:" />
          <Run Text="{Binding Movimiento.MotivoAnulacion, Mode=OneWay}" />
          <Run Text=" · " />
          <Run Text="{Binding Movimiento.FechaAnulacion, Mode=OneWay, StringFormat=dd/MM/yyyy HH:mm}" />
        </TextBlock>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
