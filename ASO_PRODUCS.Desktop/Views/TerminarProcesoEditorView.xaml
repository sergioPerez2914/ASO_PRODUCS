<UserControl x:Class="ASO_PRODUCS.Desktop.Views.TerminarProcesoEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_PRODUCS.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="380">

  <StackPanel>
    <TextBlock Text="{Binding ProductoTexto}" FontSize="{StaticResource FsBody}" TextWrapping="Wrap"
               Foreground="{DynamicResource TextSecondaryBrush}" />

    <controls:FormField Etiqueta="Cantidad producida" Ayuda="Lo que de verdad se obtuvo; puede diferir de lo planeado por una merma."
                        Margin="0,16,0,0">
      <TextBox Style="{StaticResource FormTextBoxStyle}" HorizontalAlignment="Left" Width="160"
               Text="{Binding CantidadProducida, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>

    <controls:FormField Etiqueta="Observaciones">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               AcceptsReturn="True" MinLines="2" TextWrapping="Wrap"
               VerticalContentAlignment="Top"
               Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>
  </StackPanel>
</UserControl>
