<UserControl x:Class="ASO_PRODUCS.Desktop.Views.TipoMateriaPrimaEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_PRODUCS.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="420">

  <StackPanel>
    <controls:FormField Etiqueta="Nombre">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>

    <controls:FormField Etiqueta="Unidad de medida" Ayuda="Kg, litros, sacos… lo que use la organización.">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               Text="{Binding UnidadMedida, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>

    <CheckBox Content="Activo" Margin="0,16,0,0" Cursor="Hand"
              Foreground="{DynamicResource TextPrimaryBrush}"
              IsChecked="{Binding Activo}" />

    <TextBlock Text="Un tipo inactivo se conserva en el historial, pero no se ofrece al registrar recepciones ni salidas. La existencia no se escribe aquí: sale de lo que entra y lo que sale."
               FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" />
  </StackPanel>
</UserControl>
