<UserControl x:Class="ASO_PRODUCS.Desktop.Views.ConfiguracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_PRODUCS.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">

  <UserControl.Resources>
    <!-- Fila de un ajuste: el interruptor a la izquierda y su explicacion debajo, sangrada bajo
         la etiqueta. Se repite en las tres pestanas. -->
    <Style x:Key="AyudaAjusteStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FsCaption}" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="44,4,0,0" />
    </Style>

    <Style x:Key="TituloTarjetaStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FsTitle}" />
      <Setter Property="FontWeight" Value="{StaticResource FwMedium}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="SubtituloTarjetaStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FsCaption}" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,4,0,14" />
    </Style>

    <Style x:Key="DatoStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FsSubtitle}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0" Titulo="Configuración"
                         Descripcion="Cómo se ve la aplicación, tu cuenta, y cómo se comporta en esta máquina." />

    <!-- Pestanas de verdad, subrayadas. Antes eran tres pastillas azules rellenas con el estilo
         del filtro de rango, asi que una pestana pesaba lo mismo que el boton primario de la
         pantalla; y el enlace iba de una sola via, con IsChecked="True" a fuego en la primera. -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
      <RadioButton Content="Apariencia" GroupName="ConfigVista"
                   Style="{StaticResource SegmentedTabStyle}"
                   IsChecked="{Binding EsApariencia, Mode=TwoWay}" />
      <RadioButton Content="Mi cuenta" GroupName="ConfigVista"
                   Style="{StaticResource SegmentedTabStyle}"
                   IsChecked="{Binding EsCuenta, Mode=TwoWay}" />
      <RadioButton Content="Aplicación" GroupName="ConfigVista"
                   Style="{StaticResource SegmentedTabStyle}"
                   IsChecked="{Binding EsAplicacion, Mode=TwoWay}" />
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource TabStripStyle}" VerticalAlignment="Bottom" />

    <!-- ============================= Apariencia ============================= -->
    <Grid Grid.Row="2" Margin="0,24,0,0" DataContext="{Binding Apariencia}"
          Visibility="{Binding DataContext.MostrarApariencia,
                               RelativeSource={RelativeSource AncestorType=UserControl},
                               Converter={StaticResource BoolToVis}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="520" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" MaxWidth="520" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="Tema" Style="{StaticResource TituloTarjetaStyle}" />
          <TextBlock Text="Se aplica al instante y se recuerda en esta máquina. No afecta a nadie más."
                     Style="{StaticResource SubtituloTarjetaStyle}" />

          <!-- La aplicacion entera es la vista previa: el tema cambia al marcar. -->
          <StackPanel Orientation="Horizontal">
            <RadioButton Content="Claro" GroupName="Tema"
                         Style="{StaticResource FilterChipStyle}"
                         IsChecked="{Binding EsClaro, Mode=TwoWay}" />
            <RadioButton Content="Oscuro" GroupName="Tema"
                         Style="{StaticResource FilterChipStyle}"
                         IsChecked="{Binding EsOscuro, Mode=TwoWay}" />
          </StackPanel>

          <TextBlock Text="{Binding Aviso.Texto}" Margin="0,16,0,0"
                     FontSize="{StaticResource FsCaption}"
                     Foreground="{DynamicResource SuccessTextBrush}" />
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="Escala de la interfaz" Style="{StaticResource TituloTarjetaStyle}" />
          <TextBlock Text="Agranda toda la ventana, no solo el texto: iconos, tablas y botones crecen con ella."
                     Style="{StaticResource SubtituloTarjetaStyle}" />

          <ComboBox Style="{StaticResource FormComboBoxStyle}"
                    ItemsSource="{Binding EscalasDisponibles}" DisplayMemberPath="Texto"
                    SelectedItem="{Binding Escala}" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- ============================== Mi cuenta ============================== -->
    <Grid Grid.Row="2" Margin="0,24,0,0" DataContext="{Binding Cuenta}"
          Visibility="{Binding DataContext.MostrarCuenta,
                               RelativeSource={RelativeSource AncestorType=UserControl},
                               Converter={StaticResource BoolToVis}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="520" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" MaxWidth="520" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="Quién eres" Style="{StaticResource TituloTarjetaStyle}" />
          <TextBlock Text="El rol y los permisos los ajusta un administrador desde Administración · Usuarios."
                     Style="{StaticResource SubtituloTarjetaStyle}" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" MinWidth="120" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Usuario" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,8" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding NombreUsuario}" Style="{StaticResource DatoStyle}" Margin="0,0,0,8" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Nombre completo" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,8" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NombreCompleto}" Style="{StaticResource DatoStyle}" Margin="0,0,0,8" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Rol" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,8" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RolTexto}" Style="{StaticResource DatoStyle}" Margin="0,0,0,8" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Organización" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,8" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OrganizacionTexto}" Style="{StaticResource DatoStyle}" Margin="0,0,0,8" />
          </Grid>

          <Border Margin="0,16,0,0" Padding="0,16,0,0" BorderThickness="0,1,0,0"
                  BorderBrush="{DynamicResource BorderBrush}">
            <StackPanel>
              <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                        Content="Recordar mi usuario en el inicio de sesión"
                        IsChecked="{Binding RecordarUsuario}" />
              <TextBlock Style="{StaticResource AyudaAjusteStyle}"
                         Text="Se recuerda el nombre, nunca la contraseña." />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="Cambiar mi contraseña" Style="{StaticResource TituloTarjetaStyle}" />
          <TextBlock Text="{Binding AyudaPassword}" Style="{StaticResource SubtituloTarjetaStyle}" />

          <!-- Se pide la actual aunque la sesion ya este abierta: un equipo desatendido es justo
               el caso en el que alguien cambiaria la clave ajena. -->
          <controls:FormField Etiqueta="Contraseña actual" Requerido="True">
            <PasswordBox x:Name="PasswordActual" Style="{StaticResource FormPasswordBoxStyle}" />
          </controls:FormField>

          <controls:FormField Etiqueta="Contraseña nueva" Requerido="True">
            <PasswordBox x:Name="PasswordNueva" Style="{StaticResource FormPasswordBoxStyle}" />
          </controls:FormField>

          <controls:FormField Etiqueta="Repetir la nueva" Requerido="True"
                              Error="{Binding ErrorPassword}">
            <PasswordBox x:Name="PasswordConfirmacion" Style="{StaticResource FormPasswordBoxStyle}"
                         KeyDown="OnPasswordKeyDown" />
          </controls:FormField>

          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Cambiar contraseña" Style="{StaticResource PrimaryButtonStyle}"
                    Click="OnCambiarPassword" />
            <TextBlock Text="{Binding Aviso.Texto}" VerticalAlignment="Center" Margin="12,0,0,0"
                       FontSize="{StaticResource FsCaption}"
                       Foreground="{DynamicResource SuccessTextBrush}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ============================== Aplicación ============================== -->
    <Grid Grid.Row="2" Margin="0,24,0,0" DataContext="{Binding Aplicacion}"
          Visibility="{Binding DataContext.MostrarAplicacion,
                               RelativeSource={RelativeSource AncestorType=UserControl},
                               Converter={StaticResource BoolToVis}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="520" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="Al abrir" Style="{StaticResource TituloTarjetaStyle}" />
          <TextBlock Text="Vale para todos los que usen esta máquina."
                     Style="{StaticResource SubtituloTarjetaStyle}" />

          <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                    Content="Abrir en la última sección visitada"
                    IsChecked="{Binding AbrirEnUltimaSeccion}" />
          <TextBlock Style="{StaticResource AyudaAjusteStyle}"
                     Text="Si está apagado, la aplicación siempre abre en Inicio." />

          <TextBlock Text="{Binding Aviso.Texto}" Margin="0,16,0,0"
                     FontSize="{StaticResource FsCaption}"
                     Foreground="{DynamicResource SuccessTextBrush}" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
