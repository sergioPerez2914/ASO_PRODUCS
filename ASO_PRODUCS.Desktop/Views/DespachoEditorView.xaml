<UserControl x:Class="ASO_PRODUCS.Desktop.Views.DespachoEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_PRODUCS.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="900">

  <UserControl.Resources>
    <!-- Las columnas del DataGrid no heredan DataContext; ver Controls/PuenteDeDatos.cs -->
    <controls:PuenteDeDatos x:Key="Puente" Datos="{Binding}" />
  </UserControl.Resources>

  <StackPanel>

    <!-- El tipo ya no lo elige el operador acá: queda fijo según cómo se abrió el editor (ver
         DespachoEditorViewModel). -->
    <TextBlock Text="{Binding TipoTexto}" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8" />

    <TextBlock Text="{Binding NotaModo}" Margin="0,0,0,12" TextWrapping="Wrap"
               FontSize="{StaticResource FsCaption}"
               Foreground="{DynamicResource TextMutedBrush}" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <controls:FormField Etiqueta="Fecha">
          <DatePicker Style="{StaticResource FormDatePickerStyle}"
                      SelectedDate="{Binding Fecha}" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <controls:FormField Etiqueta="Autoriza"
                            Ayuda="Queda a nombre de quien tiene la sesión abierta.">
          <TextBox Style="{StaticResource FormTextBoxStyle}" IsReadOnly="True" Focusable="False"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="{Binding AutorizadoPorNombre, Mode=OneWay}" />
        </controls:FormField>
      </StackPanel>
    </Grid>

    <!-- Solo en una Venta: a quién se le despacha -->
    <controls:FormField Etiqueta="Cliente"
                        Visibility="{Binding MuestraCliente, Converter={StaticResource BoolToVis}}">
      <ComboBox Style="{StaticResource FormComboBoxStyle}"
                ItemsSource="{Binding Clientes}"
                DisplayMemberPath="Etiqueta"
                SelectedItem="{Binding ClienteSeleccionado}" />
    </controls:FormField>

    <!-- Productos que salen -->
    <TextBlock Text="Productos que salen" Style="{StaticResource CardTitleStyle}" Margin="{StaticResource TkTituloDeBloque}" />

    <!-- La diferencia entre lo que el pedido pide y lo que los lotes alcanzan a cubrir. No se
         arma una línea para eso (no habría lote que ponerle y bloquearía todo el despacho), así
         que se avisa acá. -->
    <TextBlock Text="{Binding DiferenciaTexto}" TextWrapping="Wrap" Margin="0,0,0,8"
               FontSize="{StaticResource FsCaption}"
               Foreground="{DynamicResource DangerTextBrush}">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding DiferenciaTexto}" Value="">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <Border Style="{StaticResource SectionCardStyle}" Padding="0">
      <Grid>
        <DataGrid x:Name="TablaLineas" Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding Lineas}"
                  IsReadOnly="True"
                  MaxHeight="260"
                  HeadersVisibility="Column"
                  CanUserSortColumns="False">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Producto" Width="30*" MinWidth="200">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ComboBox Style="{StaticResource LineaComboBoxStyle}"
                            ItemsSource="{Binding Productos}"
                            DisplayMemberPath="Nombre"
                            SelectedItem="{Binding ProductoSeleccionado, UpdateSourceTrigger=PropertyChanged}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <controls:ColumnaNumero Header="Disponible" Binding="{Binding DisponibleTexto}" Width="14*" MinWidth="90" />

            <DataGridTemplateColumn Header="Cantidad" Width="14*" MinWidth="90">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBox TextAlignment="Right"
                           Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                      <!-- Aviso inmediato de que se pide más de lo que hay en existencia. Quien
                           decide de verdad es DespachosService.Validar al registrar. -->
                      <Style TargetType="TextBox" BasedOn="{StaticResource LineaTextBoxStyle}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding SePasa}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource DangerTextBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
                            <Setter Property="ToolTip" Value="No hay tanta existencia de este producto." />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBox.Style>
                  </TextBox>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Precio" Width="14*" MinWidth="90"
                                    Visibility="{Binding Datos.MuestraPrecios, Source={StaticResource Puente},
                                                         Converter={StaticResource BoolToVis}}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBox Style="{StaticResource LineaTextBoxStyle}" TextAlignment="Right"
                           Text="{Binding PrecioUnitario, UpdateSourceTrigger=PropertyChanged}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <controls:ColumnaNumero Header="Subtotal" Binding="{Binding SubtotalTexto}" Width="14*" MinWidth="90"
                                    Visibility="{Binding Datos.MuestraPrecios, Source={StaticResource Puente},
                                                         Converter={StaticResource BoolToVis}}" />

            <DataGridTemplateColumn Header="Lote" Width="30*" MinWidth="220">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ComboBox ItemsSource="{Binding LotesDelProducto}"
                            DisplayMemberPath="Etiqueta"
                            SelectedItem="{Binding LoteSeleccionado, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBox.Style>
                      <Style TargetType="ComboBox" BasedOn="{StaticResource LineaComboBoxStyle}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding LoteSeleccionado.EstadoTexto}" Value="Vencido">
                            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
                            <Setter Property="ToolTip" Value="Este lote ya venció." />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ComboBox.Style>
                  </ComboBox>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Width="56">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Content="{x:Static controls:Iconos.Limpiar}"
                          Style="{StaticResource LineaBotonQuitarStyle}"
                          ToolTip="Quitar esta línea"
                          Command="{Binding Datos.QuitarLineaCommand, Source={StaticResource Puente}}"
                          CommandParameter="{Binding}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <controls:EmptyState Compacto="True"
                             Icono="{x:Static controls:Iconos.Despacho}"
                             Titulo="Sin productos todavía"
                             Detalle="Agregue con «Agregar línea» lo que sale hacia el cliente."
                             Visibility="{Binding HasItems, ElementName=TablaLineas,
                                                  Converter={StaticResource SinItemsAVis}}" />
      </Grid>
    </Border>

    <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Button Grid.Column="0" Content="Agregar línea" Margin="0"
              Style="{StaticResource SecondaryButtonStyle}"
              Command="{Binding AgregarLineaCommand}" />

      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
        <TextBlock Text="Unidades" VerticalAlignment="Center" Margin="0,0,12,0"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBlock Text="{Binding TotalCantidad, StringFormat=N2}" Style="{StaticResource FormValorCalculadoStyle}" />
      </StackPanel>

      <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                  Visibility="{Binding MuestraPrecios, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="Total" VerticalAlignment="Center" Margin="0,0,12,0"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBlock Text="{Binding TotalTexto}" Style="{StaticResource FormValorCalculadoStyle}" />
      </StackPanel>
    </Grid>

    <controls:FormField Etiqueta="Observaciones">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               AcceptsReturn="True" MinLines="2" TextWrapping="Wrap"
               VerticalContentAlignment="Top"
               Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>
  </StackPanel>
</UserControl>
