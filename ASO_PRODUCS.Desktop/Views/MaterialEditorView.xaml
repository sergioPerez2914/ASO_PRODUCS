<UserControl x:Class="ASO_PRODUCS.Desktop.Views.MaterialEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_PRODUCS.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="560">

  <!-- El MISMO formulario para un artículo del almacén y para un tipo de materia prima: los dos
       son un material que se cuenta. Lo que cambia entre los dos (el prefijo del código, el
       validador, cómo se llama "esto") lo pone la subclase de MaterialEditorViewModel. -->
  <StackPanel>
    <controls:FormField Etiqueta="Código"
                        Ayuda="Si lo dejas vacío se genera uno automáticamente al guardar.">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBox Grid.Column="0" Style="{StaticResource FormTextBoxStyle}"
                 Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}" />

        <Button Grid.Column="2" Content="Generar" Style="{StaticResource SecondaryButtonStyle}"
                Margin="0" Command="{Binding GenerarCodigoCommand}" />
      </Grid>
    </controls:FormField>

    <controls:FormField Etiqueta="Nombre">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <controls:FormField Etiqueta="Unidad de medida"
                            Ayuda="Elige una de la lista o escribe la que use la organización.">
          <!-- Editable a propósito: la lista es una sugerencia para que el vocabulario no se
               disperse ("Kg" / "Kilogramos" / "kilos" para lo mismo), no un catálogo cerrado. -->
          <ComboBox Style="{StaticResource EditableComboBoxStyle}"
                    IsEditable="True"
                    ItemsSource="{Binding Unidades}"
                    Text="{Binding UnidadMedida, UpdateSourceTrigger=PropertyChanged}" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <controls:FormField Etiqueta="Mínimo" Ayuda="Cero significa no vigilar.">
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding Minimo, UpdateSourceTrigger=PropertyChanged}" />
        </controls:FormField>
      </StackPanel>
    </Grid>

    <CheckBox Content="Activo" Margin="0,16,0,0" Cursor="Hand"
              Foreground="{DynamicResource TextPrimaryBrush}"
              IsChecked="{Binding Activo}" />

    <TextBlock Text="{Binding AyudaInactivo}"
               FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" />
  </StackPanel>
</UserControl>
