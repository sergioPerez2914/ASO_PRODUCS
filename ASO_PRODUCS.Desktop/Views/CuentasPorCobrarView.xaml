<UserControl x:Class="ASO_PRODUCS.Desktop.Views.CuentasPorCobrarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_PRODUCS.Desktop.Controls"
             xmlns:models="clr-namespace:ASO_PRODUCS.Desktop.Models"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">

  <UserControl.Resources>
    <!-- Detalle tabular de la factura, usado como ToolTip de fila — mismo patrón que
         Views/CuentasPorPagarView.xaml: bindear ToolTip a todo el objeto hace que WPF resuelva
         este DataTemplate implícito por tipo cada vez que se muestra. -->
    <DataTemplate DataType="{x:Type models:FacturaCliente}">
      <StackPanel Grid.IsSharedSizeScope="True" MaxWidth="420">
        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" SharedSizeGroup="ColDestinoFactura" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="ColCantidadFactura" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="ColPrecioFactura" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="ColSubtotalFactura" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Destino" FontWeight="{StaticResource FwMedium}" Margin="0,0,16,0" />
          <TextBlock Grid.Column="1" Text="Cantidad" FontWeight="{StaticResource FwMedium}" Margin="0,0,16,0" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="2" Text="Precio" FontWeight="{StaticResource FwMedium}" Margin="0,0,16,0" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="3" Text="Subtotal" FontWeight="{StaticResource FwMedium}" HorizontalAlignment="Right" />
        </Grid>
        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,4" />
        <ItemsControl ItemsSource="{Binding Lineas}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" SharedSizeGroup="ColDestinoFactura" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="ColCantidadFactura" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="ColPrecioFactura" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="ColSubtotalFactura" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding DestinoTexto}" Margin="0,0,16,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding CantidadTexto}" Margin="0,0,16,0" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2" Text="{Binding PrecioUnitarioTexto}" Margin="0,0,16,0" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Text="{Binding SubtotalTexto}" HorizontalAlignment="Right" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4,0,4" />
        <TextBlock HorizontalAlignment="Right" FontWeight="{StaticResource FwMedium}"
                   Text="{Binding MontoTexto, StringFormat='Total: {0}'}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Style="{StaticResource PantallaPlenaStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0"
                         Titulo="{Binding Submodulo.Nombre}"
                         Descripcion="{Binding Submodulo.Descripcion}" />

    <!-- Facturas de venta -->
    <Grid Grid.Row="2" Margin="0,16,0,0" DataContext="{Binding Facturas}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource ToolbarStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <WrapPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
            <controls:SearchBox Width="280" Margin="0,0,12,0" VerticalAlignment="Center"
                                Texto="{Binding TextoBusqueda, Mode=TwoWay}" />

            <controls:FiltroDropdown Style="{StaticResource FiltroDropdownStyle}" SelectedIndex="0"
                                     Margin="0,0,12,0" VerticalAlignment="Center"
                                     Command="{Binding CambiarFiltroEstadoCommand}">
              <ComboBoxItem Content="Todas" />
              <ComboBoxItem Content="Pendientes" />
              <ComboBoxItem Content="Vencidas" />
              <ComboBoxItem Content="Cobradas" />
              <ComboBoxItem Content="Anuladas" />
            </controls:FiltroDropdown>
          </WrapPanel>

          <TextBlock Grid.Row="0" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                     Text="{Binding ResumenDeuda}" FontSize="{StaticResource FsBody}"
                     Foreground="{DynamicResource TextSecondaryBrush}" />

          <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                      Margin="0,12,0,0">
            <Button Content="Registrar factura" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding AgregarCommand}" />
            <Button Content="Editar" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding EditarCommand}" />
            <Button Content="Registrar cobro" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding RegistrarCobroCommand}" />
            <Button Content="Anular" Style="{StaticResource SecondaryButtonStyle}"
                    Foreground="{DynamicResource DangerTextBrush}"
                    Command="{Binding AnularCommand}" />
            <Button Content="Eliminar" Style="{StaticResource SecondaryButtonStyle}"
                    Foreground="{DynamicResource DangerTextBrush}"
                    Command="{Binding EliminarCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Padding="0">
        <Grid>
          <DataGrid x:Name="Tabla1" Style="{StaticResource DataGridStyle}"
                    ItemsSource="{Binding ItemsView}"
                    SelectedItem="{Binding SelectedItem}"
                    MouseDoubleClick="Tabla1_MouseDoubleClick">
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                <Setter Property="ToolTip" Value="{Binding}" />
                <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <controls:ColumnaTexto Header="Documento" Binding="{Binding NumeroDocumento}" Width="10*" MinWidth="78" />
              <controls:ColumnaTexto Header="Cliente" Binding="{Binding ClienteNombre}" Width="20*" MinWidth="110" />
              <controls:ColumnaTexto Header="Origen" Binding="{Binding DespachoTexto}" Width="14*" MinWidth="100" />
              <controls:ColumnaTexto Header="Descripción" Binding="{Binding Descripcion}" Width="16*" MinWidth="90" />
              <controls:ColumnaTexto Header="Emisión" Width="10*" MinWidth="78"
                                     Binding="{Binding FechaEmision, StringFormat={}{0:dd/MM/yyyy}}" />
              <controls:ColumnaTexto Header="Vencimiento" Binding="{Binding VencimientoTexto}" Width="11*" MinWidth="78" />
              <controls:ColumnaTexto Header="Plazo" Binding="{Binding PlazoTexto}" Width="14*" MinWidth="90" />
              <controls:ColumnaNumero Header="Monto" Binding="{Binding MontoTexto}" Width="11*" MinWidth="80">
                <controls:ColumnaNumero.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="FontWeight" Value="{StaticResource FwMedium}" />
                  </Style>
                </controls:ColumnaNumero.ElementStyle>
              </controls:ColumnaNumero>
              <DataGridTemplateColumn Header="Estado" Width="96">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource ChipEstadoFacturaClienteStyle}">
                      <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsCaption}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <controls:EmptyState Icono="{x:Static controls:Iconos.CuentasPorCobrar}"
                               Titulo="No hay facturas de cliente"
                               Detalle="Registra la primera factura, o despacha una venta, para empezar a controlar lo por cobrar."
                               Visibility="{Binding HasItems, ElementName=Tabla1, Converter={StaticResource SinItemsAVis}}" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
