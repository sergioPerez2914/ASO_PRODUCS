  <DataTemplate DataType="{x:Type vm:ProductoEditorViewModel}">
    <views:ProductoEditorView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:DespachoEditorViewModel}">
    <views:DespachoEditorView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:DespachoDetalleViewModel}">
    <views:DespachoDetalleView />
  </DataTemplate>

  <!-- Armazón -->

  <DataTemplate DataType="{x:Type vm:UsuarioEditorViewModel}">
    <views:UsuarioEditorView />
  </DataTemplate>

</ResourceDictionary>
