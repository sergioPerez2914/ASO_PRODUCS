<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:ASO_PRODUCS.Desktop.ViewModels"
                    xmlns:views="clr-namespace:ASO_PRODUCS.Desktop.Views">

  <!-- Cada editor CRUD aporta un UserControl de formulario; CrudEditorWindow los aloja
       a través de DataTemplate implícitos declarados aquí, sin conocer la entidad concreta.
       Se irán registrando a medida que cada submódulo tenga su editor. -->

  <!-- Editor genérico de motivo: lo reutilizan todas las anulaciones -->
  <DataTemplate DataType="{x:Type vm:MotivoEditorViewModel}">
    <views:MotivoEditorView />
  </DataTemplate>

  <!-- Finanzas · Cuentas por Pagar y Banco -->

  <DataTemplate DataType="{x:Type vm:ProveedorEditorViewModel}">
    <views:ProveedorEditorView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:FacturaProveedorEditorViewModel}">
    <views:FacturaProveedorEditorView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:FacturaProveedorDetalleViewModel}">
    <views:FacturaProveedorDetalleView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:ClienteEditorViewModel}">
    <views:ClienteEditorView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:FacturaClienteEditorViewModel}">
    <views:FacturaClienteEditorView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:FacturaClienteDetalleViewModel}">
    <views:FacturaClienteDetalleView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:AsientoBancoEditorViewModel}">
    <views:AsientoBancoEditorView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:MovimientoBancoEditorViewModel}">
    <views:MovimientoBancoEditorView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:MovimientoBancoDetalleViewModel}">
    <views:MovimientoBancoDetalleView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:CuentaBancariaEditorViewModel}">
    <views:CuentaBancariaEditorView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:TransferenciaEditorViewModel}">
    <views:TransferenciaEditorView />
  </DataTemplate>

  <!-- Inventario -->

  <DataTemplate DataType="{x:Type vm:ArticuloEditorViewModel}">
    <views:ArticuloEditorView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:EntradaEditorViewModel}">
    <views:EntradaEditorView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:EntradaDetalleViewModel}">
    <views:EntradaDetalleView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:SalidaEditorViewModel}">
    <views:SalidaEditorView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:SalidaDetalleViewModel}">
    <views:SalidaDetalleView />
  </DataTemplate>

  <!-- Materia Prima -->

  <DataTemplate DataType="{x:Type vm:TipoMateriaPrimaEditorViewModel}">
    <views:TipoMateriaPrimaEditorView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:RecepcionMateriaPrimaEditorViewModel}">
    <views:RecepcionMateriaPrimaEditorView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:RecepcionMateriaPrimaDetalleViewModel}">
    <views:RecepcionMateriaPrimaDetalleView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:SalidaMateriaPrimaEditorViewModel}">
    <views:SalidaMateriaPrimaEditorView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:SalidaMateriaPrimaDetalleViewModel}">
    <views:SalidaMateriaPrimaDetalleView />
  </DataTemplate>

  <!-- Procesos · Producción y Despacho -->

  <DataTemplate DataType="{x:Type vm:EtapaProduccionEditorViewModel}">
    <views:EtapaProduccionEditorView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:IniciarProcesoEditorViewModel}">
