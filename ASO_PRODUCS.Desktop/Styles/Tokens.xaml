<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- Tokens de forma: tipografia, espaciado y radio.

       Van por StaticResource, no por DynamicResource, y es deliberado: no cambian con el tema.
       Solo el color lo hace. Mezclar los dos mecanismos fue justo lo que costo un intento fallido
       la vez anterior (ver CLAUDE.md), asi que la regla queda partida en dos y sin excepciones:
         - color            -> DynamicResource a una clave de Colors.xaml / ColorsOscuro.xaml
         - forma y tamano   -> StaticResource a una clave de este archivo

       Este diccionario se mergea el PRIMERO en Theme.xaml, antes que Colors.xaml y Controles.xaml,
       porque los dos consumen estas claves en sus Setter. -->

  <!-- Familias. Viven aqui y no en Theme.xaml porque un diccionario fusionado no ve las claves
       de su padre: Componentes.xaml las necesita y solo puede llegar a ellas mergeando este
       archivo por su cuenta. -->
  <!-- Satoshi, empotrada en Assets/Fonts con tres cortes: Regular, Medium y Bold. Los tres
       comparten nombre de familia, asi que esta clave es una sola y quien elige el corte es el
       FontWeight. Hubo una version con SOLO el corte Bold y toda la app se veia en negrita: sin
       contraste de peso no hay jerarquia y el titulo, el cuerpo y el pie gritan igual. -->
  <FontFamily x:Key="AppFont">pack://application:,,,/Assets/Fonts/#Satoshi</FontFamily>
  <!-- Phosphor (regular), empotrada en Assets/Fonts. Los puntos de codigo tienen nombre en
       Controls/Iconos.cs; nadie deberia escribir uno a mano en el XAML. -->
  <FontFamily x:Key="IconFont">pack://application:,,,/Assets/Fonts/#Phosphor</FontFamily>

  <!-- ============================ Tipografia ============================
       Ocho tamanos sustituyen a los quince que habia sueltos por el XAML. La escala sigue siendo
       corta —es software de gestion denso—, pero los escalones de arriba estan separados de
       verdad: antes cuatro tamanos se apinnaban entre 10 y 13 y el titulo de una tarjeta apenas
       se distinguia de su contenido.

       El cuerpo subio de 12 a 13 al recuperar los tres cortes de Satoshi: el texto en Regular
       pesa menos en pantalla que el mismo texto en Bold, y sin ese punto de mas se leia
       enclenque. El sitio lo devuelve el espaciado, que es mas compacto. -->

  <sys:Double x:Key="FsHero">36</sys:Double>     <!-- glifo de estado vacio          -->
  <sys:Double x:Key="FsMetric">28</sys:Double>   <!-- valor de un indicador          -->
  <sys:Double x:Key="FsDisplay">22</sys:Double>  <!-- titulo de pantalla             -->
  <sys:Double x:Key="FsTitle">16</sys:Double>    <!-- titulo de seccion o tarjeta    -->
  <sys:Double x:Key="FsSubtitle">14</sys:Double> <!-- cuerpo enfatizado, dato fuerte -->
  <sys:Double x:Key="FsBody">13</sys:Double>     <!-- cuerpo por defecto             -->
  <sys:Double x:Key="FsCaption">11</sys:Double>  <!-- texto de ayuda, pie de campo   -->
  <sys:Double x:Key="FsMicro">10</sys:Double>    <!-- chips, contadores, etiquetas   -->

  <!-- Tres pesos, que son los tres cortes empotrados. FwMedium es Medium y no SemiBold a
       proposito: Satoshi no trae SemiBold, y pedirselo hace que WPF lo SINTETICE engordando el
       Medium, que es justo el emborronado que se ve en las fuentes mal montadas. -->
  <FontWeight x:Key="FwNormal">Normal</FontWeight>
  <FontWeight x:Key="FwMedium">Medium</FontWeight>
  <FontWeight x:Key="FwBold">Bold</FontWeight>

  <!-- ============================ Espaciado =============================
       Escala de base 4. Los 56 valores distintos de Margin que habia no seguian ninguna, y es la
       razon concreta de que cada pantalla tuviera su propio ritmo. -->

  <sys:Double x:Key="Sp1">4</sys:Double>
  <sys:Double x:Key="Sp2">8</sys:Double>
  <sys:Double x:Key="Sp3">12</sys:Double>
  <sys:Double x:Key="Sp4">16</sys:Double>
  <sys:Double x:Key="Sp5">24</sys:Double>
  <sys:Double x:Key="Sp6">32</sys:Double>

  <!-- Thickness ya compuestos para los casos que se repiten. Un Margin en XAML no puede componerse
       de varias claves, asi que los pares utiles se declaran enteros. -->
  <Thickness x:Key="TkNone">0</Thickness>
  <Thickness x:Key="TkCampo">0,0,0,12</Thickness>          <!-- separacion entre campos de un formulario -->
  <Thickness x:Key="TkEtiqueta">0,0,0,4</Thickness>        <!-- etiqueta sobre su campo                  -->
  <Thickness x:Key="TkAyuda">0,4,0,0</Thickness>           <!-- ayuda bajo su campo                      -->
  <Thickness x:Key="TkSeccion">0,0,0,16</Thickness>        <!-- bloque sobre bloque                      -->
  <Thickness x:Key="TkBloque">0,0,0,24</Thickness>         <!-- banda sobre banda                        -->
  <Thickness x:Key="TkTarjeta">16</Thickness>              <!-- relleno interior de una tarjeta          -->
  <Thickness x:Key="TkTarjetaCompacta">12</Thickness>
  <Thickness x:Key="TkBarra">0,0,0,12</Thickness>          <!-- barra de acciones sobre la tabla         -->
  <Thickness x:Key="TkEntreTarjetas">0,0,12,12</Thickness> <!-- tarjeta junto a tarjeta en un WrapPanel  -->

  <!-- Rellenos de control. El alto real de un boton lo fija MinHeight en el estilo implicito, no
       este relleno: con solo relleno, dos botones con texto de distinta altura de linea salian de
       distinto tamano y la barra de acciones quedaba dentada. -->
  <Thickness x:Key="TkControl">8,4</Thickness>             <!-- relleno de una caja de captura           -->
  <Thickness x:Key="TkBoton">12,4</Thickness>
  <Thickness x:Key="TkBotonPrimario">14,4</Thickness>
  <Thickness x:Key="TkChip">8,2</Thickness>

  <sys:Double x:Key="AltoControl">28</sys:Double>          <!-- boton, buscador, desplegable            -->
  <sys:Double x:Key="AltoFila">32</sys:Double>             <!-- fila de tabla                           -->

  <!-- ============================== Forma ==============================
       Tres radios. Los seis que habia (0, 3, 4, 6, 8, 10, 13) no distinguian nada. -->

  <CornerRadius x:Key="RadSm">4</CornerRadius>     <!-- controles: caja, boton, celda -->
  <CornerRadius x:Key="RadMd">6</CornerRadius>     <!-- tarjeta, seccion, panel       -->
  <!-- Ya NO lo usan los chips de estado, que llevan RadSm como el resto de la interfaz: queda
       para lo que es redondo por su forma —el contador del menu, el interruptor, y las barras
       de 2-3 px cuyos extremos hay que rematar. -->
  <CornerRadius x:Key="RadPill">999</CornerRadius> <!-- contador, interruptor, barra   -->

  <!-- Grosor del borde que separa superficies. Es el separador general: en una interfaz densa el
       borde separa mejor que la sombra, cuesta menos de pintar y respeta el tema.

       La sombra NO desaparecio del todo, pero quedo acotada a lo que de verdad flota por encima
       de la pagina —desplegables, calendario, tooltip, menu—, y con color propio por tema
       (ElevacionColor). La version que se quito llevaba Color="#000000" a fuego y sobre el fondo
       oscuro era una mancha; el error era el negro fijo y ponerla en todas las tarjetas, no la
       sombra en si. Una tarjeta de datos sigue sin llevarla. -->
  <Thickness x:Key="BdFino">1</Thickness>
  <Thickness x:Key="BdFoco">2</Thickness>

  <!-- ============================= Movimiento =============================
       Dos duraciones y una curva, compartidas. Nada pasa de 180 ms y nada mueve contenido salvo
       el despliegue del sidebar: en los equipos del campo el movimiento tiene que leerse como
       "suave", no como "lento".

       Regla al animar: se anima la OPACIDAD de un velo o de un borde superpuesto, nunca el color
       de un brush. Los brushes de los diccionarios estan congelados en cuanto se cargan (ver
       Services/Tema.cs), asi que animarlos lanza; y ademas la opacidad funciona igual en los dos
       temas sin escribir dos veces la animacion. -->
  <Duration x:Key="DurRapida">0:0:0.12</Duration>
  <Duration x:Key="DurNormal">0:0:0.18</Duration>
  <CubicEase x:Key="CurvaSalida" EasingMode="EaseOut" />

</ResourceDictionary>
