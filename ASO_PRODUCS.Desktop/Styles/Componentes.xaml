<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ASO_PRODUCS.Desktop.Controls">

  <!-- Capa de componentes.

       Lo que hay aqui es la respuesta al diagnostico de que las 56 vistas redibujaban la misma
       cromatica desde cero: el encabezado copiado en 21 archivos, el boton primario escrito a mano
       27 veces, el par etiqueta+campo suelto unas 200. Cada bloque de este archivo mata una de esas
       repeticiones.

       Los estilos de los controles propios son IMPLICITOS (sin x:Key): las clases de Controls/ no
       sobreescriben DefaultStyleKey, asi que WPF los resuelve por tipo desde Application.Resources
       y no hace falta un Themes/Generic.xaml.

       Reglas que se siguen aqui sin excepcion: el color va por DynamicResource a una clave de
       paleta, y el tamano y la forma por StaticResource a una clave de Tokens.xaml. -->

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Tokens.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <controls:TextoAVisibilidad x:Key="TextoAVis" />
  <controls:SinItemsAVisibilidad x:Key="SinItemsAVis" />

  <!-- ========================= Encabezado de pantalla ========================= -->

  <Style TargetType="{x:Type controls:PageHeader}">
    <Setter Property="Margin" Value="{StaticResource TkSeccion}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:PageHeader}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock Text="{TemplateBinding Titulo}"
                         FontFamily="{StaticResource AppFont}"
                         FontSize="{StaticResource FsDisplay}"
                         FontWeight="{StaticResource FwBold}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{TemplateBinding Descripcion}"
                         FontFamily="{StaticResource AppFont}"
                         FontSize="{StaticResource FsBody}"
                         LineHeight="19" LineStackingStrategy="BlockLineHeight"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         TextWrapping="Wrap" Margin="{StaticResource TkAyuda}"
                         Visibility="{Binding Descripcion, RelativeSource={RelativeSource TemplatedParent},
                                              Converter={StaticResource TextoAVis}}" />
            </StackPanel>

            <!-- Ranura de acciones. Vacia no ocupa nada. -->
            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================== Campo de formulario ============================== -->

  <Style TargetType="{x:Type controls:FormField}">
    <Setter Property="Margin" Value="{StaticResource TkCampo}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:FormField}">
          <StackPanel>

            <!-- Etiqueta. El asterisco de requerido va aparte y en color de peligro para que se
                 distinga del nombre del campo aunque se lea rapido. -->
            <StackPanel Orientation="Horizontal" Margin="{StaticResource TkEtiqueta}">
              <TextBlock Text="{TemplateBinding Etiqueta}"
                         FontFamily="{StaticResource AppFont}"
                         FontSize="{StaticResource FsBody}"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock x:Name="Asterisco" Text="*" Margin="2,0,0,0"
                         FontFamily="{StaticResource AppFont}"
                         FontSize="{StaticResource FsBody}"
                         Foreground="{DynamicResource DangerTextBrush}"
                         Visibility="Collapsed" />
            </StackPanel>

            <ContentPresenter HorizontalAlignment="Stretch" />

            <TextBlock x:Name="Ayuda" Text="{TemplateBinding Ayuda}"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="{StaticResource FsCaption}"
                       LineHeight="16" LineStackingStrategy="BlockLineHeight"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap" Margin="{StaticResource TkAyuda}"
                       Visibility="{Binding Ayuda, RelativeSource={RelativeSource TemplatedParent},
                                            Converter={StaticResource TextoAVis}}" />

            <!-- El error sustituye a la ayuda: los dos a la vez compiten, y el que importa es el
                 error. Antes lo unico que habia era un TextBlock rojo al pie de la ventana del
                 editor, que solo aparecia al pulsar Guardar y no decia de que campo hablaba. -->
            <TextBlock x:Name="Error" Text="{TemplateBinding Error}"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="{StaticResource FsCaption}"
                       Foreground="{DynamicResource DangerTextBrush}"
                       TextWrapping="Wrap" Margin="{StaticResource TkAyuda}"
                       Visibility="{Binding Error, RelativeSource={RelativeSource TemplatedParent},
                                            Converter={StaticResource TextoAVis}}" />
          </StackPanel>

          <ControlTemplate.Triggers>
            <Trigger Property="Requerido" Value="True">
              <Setter TargetName="Asterisco" Property="Visibility" Value="Visible" />
            </Trigger>
            <DataTrigger Binding="{Binding Error, RelativeSource={RelativeSource Self},
                                           Converter={StaticResource TextoAVis}}" Value="Visible">
              <Setter TargetName="Ayuda" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================ Indicador ================================ -->

  <Style TargetType="{x:Type controls:KpiTile}">
    <Setter Property="MinWidth" Value="160" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:KpiTile}">
          <Border Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="{StaticResource BdFino}"
                  CornerRadius="{StaticResource RadMd}"
                  Padding="{StaticResource TkTarjetaCompacta}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!-- Barra de estado. En Normal no se pinta: el color solo aparece cuando significa
                   algo, que es la unica forma de que se note cuando aparece. -->
              <Border x:Name="Barra" Grid.Column="0" Width="3" Margin="0,0,10,0"
                      CornerRadius="{StaticResource RadPill}" Background="Transparent" />

              <StackPanel Grid.Column="1">
                <TextBlock Text="{TemplateBinding Etiqueta}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="{StaticResource FsMicro}"
                           FontWeight="{StaticResource FwMedium}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis" />

                <Grid Margin="0,2,0,0">
                  <TextBlock x:Name="Valor" Text="{TemplateBinding Valor}"
                             FontFamily="{StaticResource AppFont}"
                             FontSize="{StaticResource FsMetric}"
                             FontWeight="{StaticResource FwBold}"
                             Typography.NumeralAlignment="Tabular"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             TextTrimming="CharacterEllipsis" />
                  <!-- Esqueleto: ocupa el mismo alto que el valor para que la tarjeta no salte
                       cuando llega el dato. -->
                  <Border x:Name="Esqueleto" Visibility="Collapsed"
                          Height="28" Width="64" HorizontalAlignment="Left"
                          CornerRadius="{StaticResource RadSm}"
                          Background="{DynamicResource NeutralSoftBrush}" />
                </Grid>

                <TextBlock x:Name="Nota" Text="{TemplateBinding Nota}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="{StaticResource FsCaption}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap" Margin="0,2,0,0"
                           Visibility="{Binding Nota, RelativeSource={RelativeSource TemplatedParent},
                                                Converter={StaticResource TextoAVis}}" />
              </StackPanel>
            </Grid>
          </Border>

          <ControlTemplate.Triggers>
            <Trigger Property="Estado" Value="Atencion">
              <Setter TargetName="Barra" Property="Background" Value="{DynamicResource WarningTextBrush}" />
              <Setter TargetName="Valor" Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
            </Trigger>
            <Trigger Property="Estado" Value="Critico">
              <Setter TargetName="Barra" Property="Background" Value="{DynamicResource DangerTextBrush}" />
              <Setter TargetName="Valor" Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
            </Trigger>
            <Trigger Property="Cargando" Value="True">
              <Setter TargetName="Valor" Property="Visibility" Value="Hidden" />
              <Setter TargetName="Esqueleto" Property="Visibility" Value="Visible" />
              <Setter TargetName="Nota" Property="Visibility" Value="Hidden" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- =============================== Estado vacio =============================== -->

  <Style TargetType="{x:Type controls:EmptyState}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:EmptyState}">
          <StackPanel x:Name="Bloque" HorizontalAlignment="Center" VerticalAlignment="Center"
                      MaxWidth="360" Margin="{StaticResource TkTarjeta}">
            <TextBlock x:Name="Glifo" Text="{TemplateBinding Icono}"
                       FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FsHero}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="Titulo" Text="{TemplateBinding Titulo}"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="{StaticResource FsSubtitle}"
                       FontWeight="{StaticResource FwMedium}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="0,12,0,0" />
            <TextBlock Text="{TemplateBinding Detalle}"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="{StaticResource FsCaption}"
                       LineHeight="16" LineStackingStrategy="BlockLineHeight"
                       Foreground="{DynamicResource TextMutedBrush}"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="{StaticResource TkAyuda}"
                       Visibility="{Binding Detalle, RelativeSource={RelativeSource TemplatedParent},
                                            Converter={StaticResource TextoAVis}}" />
            <ContentPresenter HorizontalAlignment="Center" Margin="0,12,0,0" />
          </StackPanel>

          <ControlTemplate.Triggers>
            <!-- Dentro de un modal el hueco vacío mide poco más que el propio bloque: el glifo de
                 página se comía la mitad de la caja y quedaba pegado al encabezado de la tabla. -->
            <Trigger Property="Compacto" Value="True">
              <Setter TargetName="Bloque" Property="Margin" Value="{StaticResource TkTarjetaCompacta}" />
              <Setter TargetName="Glifo" Property="FontSize" Value="{StaticResource FsDisplay}" />
              <Setter TargetName="Titulo" Property="FontSize" Value="{StaticResource FsBody}" />
              <Setter TargetName="Titulo" Property="Margin" Value="0,8,0,0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- =============================== Caja de busqueda =============================== -->

  <Style TargetType="{x:Type controls:SearchBox}">
    <Setter Property="MinWidth" Value="200" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:SearchBox}">
          <Border x:Name="Marco"
                  Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="{StaticResource BdFino}"
                  CornerRadius="{StaticResource RadSm}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0" Text="{x:Static controls:Iconos.Buscar}" Margin="8,0,6,0"
                         FontFamily="{StaticResource IconFont}"
                         FontSize="{StaticResource FsBody}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         VerticalAlignment="Center" />

              <Grid Grid.Column="1">
                <TextBox x:Name="Caja" Background="Transparent" BorderThickness="0"
                         Padding="0" VerticalContentAlignment="Center"
                         FontFamily="{StaticResource AppFont}"
                         FontSize="{StaticResource FsBody}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         Text="{Binding Texto, RelativeSource={RelativeSource TemplatedParent},
                                        Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <!-- El texto de sugerencia dice sobre que campos busca. Antes no habia ninguno:
                     la unica pista era un ToolTip al pasar el raton. -->
                <TextBlock x:Name="Sugerencia" Text="{TemplateBinding Sugerencia}"
                           IsHitTestVisible="False" VerticalAlignment="Center"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="{StaticResource FsBody}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Visibility="Collapsed" />
              </Grid>

              <Button x:Name="PART_Limpiar" Grid.Column="2" Width="24"
                      Background="Transparent" BorderThickness="0" Cursor="Hand"
                      Focusable="False" ToolTip="Limpiar la búsqueda">
                <TextBlock Text="{x:Static controls:Iconos.Limpiar}" FontFamily="{StaticResource IconFont}"
                           FontSize="{StaticResource FsMicro}"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </Button>
            </Grid>
          </Border>

          <ControlTemplate.Triggers>
            <Trigger Property="Texto" Value="">
              <Setter TargetName="Sugerencia" Property="Visibility" Value="Visible" />
              <Setter TargetName="PART_Limpiar" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Texto" Value="{x:Null}">
              <Setter TargetName="Sugerencia" Property="Visibility" Value="Visible" />
              <Setter TargetName="PART_Limpiar" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger SourceName="Caja" Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Marco" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ Ruta de navegacion ============================ -->

  <Style TargetType="{x:Type controls:Breadcrumb}">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:Breadcrumb}">
          <ItemsControl ItemsSource="{TemplateBinding Segmentos}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="Separador" Text="{x:Static controls:Iconos.ChevronDerecha}"
                             Margin="4,0,4,0" VerticalAlignment="Center"
                             FontFamily="{StaticResource IconFont}"
                             FontSize="{StaticResource FsCaption}"
                             Foreground="{DynamicResource TextMutedBrush}" />

                  <!-- Cada tramo anterior es un boton; el ultimo, donde se esta, se queda como
                       texto (Comando nulo, IsHitTestVisible en falso). -->
                  <Button x:Name="Tramo" Content="{Binding Texto}"
                          Command="{Binding Comando}"
                          Padding="2,1" BorderThickness="0" Background="Transparent"
                          Cursor="Hand"
                          FontFamily="{StaticResource AppFont}"
                          FontSize="{StaticResource FsBody}"
                          Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding EsPrimero}" Value="True">
                    <Setter TargetName="Separador" Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding EsNavegable}" Value="False">
                    <Setter TargetName="Tramo" Property="IsHitTestVisible" Value="False" />
                    <Setter TargetName="Tramo" Property="Focusable" Value="False" />
                    <Setter TargetName="Tramo" Property="Cursor" Value="Arrow" />
                    <Setter TargetName="Tramo" Property="FontWeight" Value="{StaticResource FwMedium}" />
                    <Setter TargetName="Tramo" Property="Foreground"
                            Value="{DynamicResource TextPrimaryBrush}" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
