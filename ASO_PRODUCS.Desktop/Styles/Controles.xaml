<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:p="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                    xmlns:c="clr-namespace:ASO_PRODUCS.Desktop.Controls">

    <c:SeleccionATexto x:Key="SeleccionATexto" />

    <!-- Estilos IMPLICITOS (sin x:Key) de los controles de WPF.

         Motivo: la plantilla que trae WPF de fabrica (Aero2) pinta sus fondos con brushes
         propios escritos dentro del tema del framework, no con SystemColors ni con nada que se
         pueda sustituir por clave desde fuera. Sobre el tema oscuro eso deja cajas blancas con
         texto claro encima — invisible. Poner Background en el Style no basta en la mitad de los
         casos (ComboBox, CheckBox, DatePicker, ScrollBar): hay que reemplazar la plantilla.

         Al ser implicitos alcanzan tambien a los controles que ninguna pantalla estilo a mano
         (el TextBox del login, los CheckBox de los editores, las barras de scroll), que son
         justo los que se quedaban blancos.

         Todo color va por DynamicResource: ver la nota de Services/Tema.cs.

         Y los TOKENS (AppFont, IconFont, RadSm…) tambien, aunque no cambien con el tema. El
         motivo es otro y muerde en silencio: este archivo es un diccionario HERMANO de
         Tokens.xaml —los dos los mergea Theme.xaml— y un StaticResource escrito DENTRO de una
         ControlTemplate no se resuelve al cargar el diccionario, sino al instanciar la plantilla,
         y ahi ya no alcanza al hermano. Revienta con "No se puede encontrar el recurso con el
         nombre 'RadSm'".

         Lo peor es cuando revienta: compila sin una queja y no falla al arrancar, sino la
         primera vez que se pinta un control de esa plantilla. Poner RadSm por StaticResource en
         el ComboBox no dio guerra hasta que se abrio una pantalla con un desplegable; en el
         TextBox tumbo el login en el acto. Con DynamicResource se busca en el arbol de recursos
         de la aplicacion, donde Tokens.xaml si esta. -->


    <!-- ============================ Botones ============================ -->

    <!-- El boton corriente. Sin esto se queda con la plantilla de fabrica, que al pasar el raton
         cambia a un azul claro escrito a fuego en el tema de WPF: en modo oscuro el boton se
         volvia una pastilla clara. Solo Flota se libraba, porque define su propio estilo.

         El realce va en un VELO translucido encima y no cambiando el Background, porque cada
         boton trae el suyo (verde primario, transparente, rojo de emergencia) y sustituirlo lo
         perderia. El velo oscurece en el tema claro y aclara en el oscuro.

         El velo entra y sale con un fundido de 120 ms, y lo que se anima es su OPACIDAD, no su
         color: los brushes de la paleta estan congelados y animarlos lanza (ver Services/Tema.cs).
         El pulsado, en cambio, cambia en seco: una pulsacion tiene que sentirse inmediata.

         MinHeight fija el alto de todos los botones. Con solo Padding, dos botones con textos de
         distinta altura de linea salian de distinto tamano y la barra de acciones quedaba
         dentada. -->
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <!-- El tooltip se ve TAMBIEN con el boton apagado, y ese es justo el momento en que hace
             falta: los botones se deshabilitan por permiso (CrudViewModelBase) o por el estado
             del documento, se atenuan a Opacity 0.45 mas abajo, y sin esto lo unico que veia
             quien no podia pulsarlos era un boton gris sin explicacion — el tooltip que la daba
             es lo primero que WPF deja de mostrar en un control deshabilitado. -->
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="{DynamicResource AltoControl}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Fondo" CornerRadius="{DynamicResource RadSm}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="Velo" CornerRadius="{DynamicResource RadSm}" Opacity="0"
                                Background="{DynamicResource HoverOverlayBrush}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Velo"
                                                         Storyboard.TargetProperty="Opacity" To="1"
                                                         Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Velo"
                                                         Storyboard.TargetProperty="Opacity" To="0"
                                                         Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Velo" Property="Background"
                                    Value="{DynamicResource PressedOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush"
                                    Value="{DynamicResource FocusRingBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Texto ============================ -->

    <!-- La plantilla va reemplazada, y no solo los colores, por el motivo de la nota de arriba:
         Aero2 pinta el borde de la caja enfocada con un AZUL escrito a fuego (#569DE5) que no
         sale de ninguna clave sustituible. Poner BorderBrush en el Style no lo alcanza, porque
         el trigger de la plantilla de fabrica lo tapa en cuanto la caja recibe el foco.

         Mientras la aplicacion fue azul el fallo era invisible —un azul mas entre azules—, pero
         con la paleta verde cada campo enfocado salia con un cerco azul de otra familia. Medido
         sobre la ventana de login: 668 pixeles de #569DE5 alrededor de la caja de contrasena. -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBlueBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="{DynamicResource RadSm}" SnapsToDevicePixels="True"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource AccentBlueBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource FocusRingBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                            <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBlueBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" CornerRadius="{DynamicResource RadSm}" SnapsToDevicePixels="True"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource AccentBlueBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource FocusRingBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                            <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ ComboBox ============================ -->

    <!-- El boton que abre la lista. Va aparte porque la plantilla del ComboBox lo necesita
         entero: es el que ocupa todo el control y recibe el clic. -->
    <Style x:Key="ComboBoxBotonStyle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" SnapsToDevicePixels="True"
                            CornerRadius="{DynamicResource RadSm}">
                        <Path x:Name="Flecha" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,0,8,0" Data="M 0 0 L 4 4 L 8 0 Z"
                              Fill="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource AccentBlueBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Flecha" Property="Fill"
                                    Value="{DynamicResource TextMutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource ComboBoxBotonStyle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}" />

                        <!-- Dos formas de pintar la caja cerrada, y solo una visible.

                             Con DisplayMemberPath manda el TextBlock, que resuelve la ruta con
                             el convertidor: SelectionBoxItemTemplate se queda en null en ese
                             caso (medido, y tambien en el ComboBox de fabrica), asi que un
                             ContentPresenter acabaria pintando el ToString() del objeto — en un
                             record de C#, el volcado de todas sus propiedades.

                             Con ItemTemplate manda el ContentPresenter, que es quien sabe
                             aplicar una plantilla con varios elementos dentro. -->
                        <TextBlock x:Name="TextoSeleccion" Visibility="Collapsed"
                                   Margin="{TemplateBinding Padding}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{TemplateBinding Foreground}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource SeleccionATexto}">
                                    <Binding Path="SelectionBoxItem"
                                             RelativeSource="{RelativeSource TemplatedParent}" />
                                    <Binding Path="DisplayMemberPath"
                                             RelativeSource="{RelativeSource TemplatedParent}" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>

                        <ContentPresenter x:Name="contentPresenter"
                                          Content="{Binding SelectionBoxItem,
                                                            RelativeSource={RelativeSource TemplatedParent}}"
                                          ContentTemplate="{Binding ItemTemplate,
                                                                    RelativeSource={RelativeSource TemplatedParent}}"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"
                                          IsHitTestVisible="False"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />

                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <!-- El desplegable repite la esquina de la caja cerrada. El Padding de
                                 2 no es decorativo: el realce de un item es un rectangulo, y sin
                                 ese hueco el primero y el ultimo volverian a cuadrar las esquinas
                                 al pasar el raton, que es justo lo que se venia a quitar. -->
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource RadSm}" Padding="2"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,0,8,8"
                                    Effect="{DynamicResource SombraFlotante}">
                                <!-- El desplegable SI flota sobre la pagina, y es de las pocas
                                     cosas que llevan sombra. El margen de la derecha y abajo
                                     existe para que el desenfoque tenga sitio; sin el, la ventana
                                     del Popup lo recorta a ras del borde. -->

                                <ScrollViewer>
                                    <ItemsPresenter SnapsToDevicePixels="True" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ItemTemplate" Value="{x:Null}">
                            <Setter TargetName="TextoSeleccion" Property="Visibility" Value="Visible" />
                            <Setter TargetName="contentPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="TextoSeleccion" Property="Foreground"
                                    Value="{DynamicResource TextMutedBrush}" />
                            <Setter TargetName="contentPresenter" Property="TextElement.Foreground"
                                    Value="{DynamicResource TextMutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                            CornerRadius="{DynamicResource RadSm}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource NavHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource NavSelectedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- El ComboBox de arriba es SOLO de seleccion: su plantilla no tiene un
         PART_EditableTextBox real, asi que IsEditable="True" sobre ese estilo no muestra caja
         para escribir. Este es aparte, para el caso de "elegir uno existente o escribir uno
         nuevo" (Cargo de Empleado): en vez de tocar el ComboBox compartido -y arriesgar los
         demas desplegables de solo-seleccion de la app-, es una plantilla propia con una caja de
         texto real. El TextBox interno es implicito (ver el estilo de TextBox de arriba), asi que
         ya trae PART_ContentHost, borde y foco resueltos solos; aqui solo se le quita su propio
         fondo/borde para que se vea como una sola caja con la flecha. -->
    <Style x:Key="ComboBoxFlechaStyle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <Path HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M 0 0 L 4 4 L 8 0 Z"
                              Fill="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EditableComboBoxStyle" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FsBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="{DynamicResource RadSm}" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />

                        <!-- Solo se le quita fondo y borde propios: el resto (PART_ContentHost,
                             caret, seleccion) lo resuelve el estilo implicito de TextBox. -->
                        <TextBox x:Name="PART_EditableTextBox"
                                 Background="Transparent" BorderThickness="0"
                                 CharacterCasing="Upper"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"
                                 Margin="{TemplateBinding Padding}" Padding="0"
                                 VerticalContentAlignment="Center" />

                        <ToggleButton x:Name="Boton" Style="{StaticResource ComboBoxFlechaStyle}"
                                      Width="24" HorizontalAlignment="Right"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}" />

                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource RadSm}" Padding="2"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,0,8,8"
                                    Effect="{DynamicResource SombraFlotante}">
                                <ScrollViewer>
                                    <ItemsPresenter SnapsToDevicePixels="True" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource AccentBlueBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource FocusRingBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Mismo esqueleto que EditableComboBoxStyle (TextBox real + flecha + Popup), pero para el
         otro caso: "buscar entre los ya existentes y elegir uno", no "escribir uno nuevo". Por
         eso NO lleva CharacterCasing -no hay razon para mayusculizar una busqueda- y en la vista
         se ata SelectedItem a un objeto real, nunca Text a un string suelto. Va aparte de
         EditableComboBoxStyle en vez de parametrizarlo porque CharacterCasing se fija en el
         TextBox interno, no es una propiedad del ComboBox que se pueda TemplateBinding-ear. -->
    <Style x:Key="BuscarComboBoxStyle" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FsBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="{DynamicResource RadSm}" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />

                        <TextBox x:Name="PART_EditableTextBox"
                                 Background="Transparent" BorderThickness="0"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"
                                 Margin="{TemplateBinding Padding}" Padding="0"
                                 VerticalContentAlignment="Center" />

                        <ToggleButton x:Name="Boton" Style="{StaticResource ComboBoxFlechaStyle}"
                                      Width="24" HorizontalAlignment="Right"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}" />

                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource RadSm}" Padding="2"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,0,8,8"
                                    Effect="{DynamicResource SombraFlotante}">
                                <ScrollViewer>
                                    <ItemsPresenter SnapsToDevicePixels="True" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource AccentBlueBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource FocusRingBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ CheckBox ============================ -->

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Caja" Width="15" Height="15" CornerRadius="{DynamicResource RadSm}"
                                VerticalAlignment="Center" SnapsToDevicePixels="True"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource TextMutedBrush}" BorderThickness="1">
                            <Path x:Name="Marca" Visibility="Collapsed" Stretch="Uniform"
                                  Margin="2,3,2,3" Stroke="White" StrokeThickness="2"
                                  StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                  Data="M 0 4 L 3.5 7.5 L 9 1" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Caja" Property="Background"
                                    Value="{DynamicResource AccentBlueBrush}" />
                            <Setter TargetName="Caja" Property="BorderBrush"
                                    Value="{DynamicResource AccentBlueBrush}" />
                            <Setter TargetName="Marca" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Caja" Property="BorderBrush"
                                    Value="{DynamicResource AccentBlueBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                            <Setter TargetName="Caja" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Listas ============================ -->

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource NavHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource NavSelectedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ DataGrid ============================ -->

    <!-- Cabecera de columna. Es un ROTULO, no una fila mas: va en minuscula pequena, en gris y
         sin relleno propio, y lo unico que la separa del cuerpo es una linea mas marcada que las
         de las filas. Antes se pintaba con FilaAlternaBrush —el mismo color que la fila alterna—,
         asi que a media tabla la cabecera y una fila cualquiera eran indistinguibles. -->
    <Style TargetType="p:DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FsCaption}" />
        <Setter Property="FontWeight" Value="{DynamicResource FwMedium}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="p:DataGridColumnHeader">
                    <!-- Solo la linea de abajo, y del escalon fuerte: el cuerpo dejo de llevar
                         rejilla vertical, asi que un separador a la derecha del rotulo ya no
                         continuaba en ninguna parte. -->
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0,0,0,1"
                            Padding="{TemplateBinding Padding}">
                        <!-- HorizontalAlignment enlazado y no fijo: el Setter de arriba pone
                             Left, pero la plantilla lo ignoraba y ninguna cabecera podia
                             alinearse de otra forma aunque su columna lo pidiera. Es lo que deja
                             que las columnas de cifras lleven el rotulo sobre el valor. -->
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cabecera de una columna de cifras.

         Unica diferencia con la corriente: el rotulo cae del mismo lado que los digitos. Lo
         consume ColumnaNumero por clave, y no por tipo, para que el estilo implicito de arriba
         siga valiendo para las demas columnas. -->

    <Style x:Key="CabeceraNumeroStyle" TargetType="p:DataGridColumnHeader"
           BasedOn="{StaticResource {x:Type p:DataGridColumnHeader}}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>

    <!-- MinHeight, y no solo el relleno de la celda: con filas de 28 px las tablas de ocho
         columnas se leian como un bloque compacto de texto. 32 px es lo que separa las lineas lo
         justo para seguir una con la vista sin perder densidad. -->
    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="MinHeight" Value="{DynamicResource AltoFila}" />
    </Style>

    <!-- La fila bajo el raton. No existia: en las diecinueve tablas de la aplicacion, pasar el
         raton por encima no cambiaba nada, asi que en una fila de ocho columnas no habia forma
         de seguir con la vista cual se estaba senalando antes de hacer clic. Va en la celda y no
         en la fila porque la celda es quien trae ControlTemplate propia, y su fondo taparia
         cualquier cosa que pintara la fila debajo. -->

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Grid SnapsToDevicePixels="True">
                        <!-- El senalado es un velo con la opacidad animada, como en los botones, y
                             la seleccion un fondo propio debajo. Van en capas separadas porque
                             hacen cosas distintas: el senalado acompana al raton y se funde; la
                             seleccion dice donde estas y tiene que aparecer en seco. -->
                        <Border x:Name="Seleccion" Background="{DynamicResource InfoSoftBrush}"
                                Opacity="0" />
                        <Border x:Name="Velo" Background="{DynamicResource HoverOverlayBrush}"
                                Opacity="0" />
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Value="True"
                                     Binding="{Binding IsMouseOver,
                                                       RelativeSource={RelativeSource AncestorType=DataGridRow}}">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Velo"
                                                         Storyboard.TargetProperty="Opacity" To="1"
                                                         Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Velo"
                                                         Storyboard.TargetProperty="Opacity" To="0"
                                                         Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <!-- La fila elegida se tine de verde suave. Antes usaba NavSelectedBrush,
                             que es el color del modulo activo del menu: significa otra cosa, y
                             ademas se separaba del senalado por un 4 % de luminancia, o sea nada. -->
                        <DataTrigger Value="True"
                                     Binding="{Binding IsSelected,
                                                       RelativeSource={RelativeSource AncestorType=DataGridRow}}">
                            <Setter TargetName="Seleccion" Property="Opacity" Value="1" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Menu ============================ -->

    <Style TargetType="Menu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ============================ Barras de scroll ============================ -->

    <Style x:Key="ScrollBarPistaStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarPulgarStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" CornerRadius="{DynamicResource RadSm}" Margin="2"
                            Background="{DynamicResource TextMutedBrush}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource TextSecondaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarPistaStyle}"
                                              Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarPulgarStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarPistaStyle}"
                                              Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBarPistaStyle}"
                                                      Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBarPulgarStyle}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBarPistaStyle}"
                                                      Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================ Fecha ============================ -->

    <!-- La caja de texto del DatePicker trae una marca de agua con fondo propio; se reemplaza
         la plantilla entera para que no asome. -->
    <Style TargetType="p:DatePickerTextBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBlueBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="p:DatePickerTextBox">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DatePickerBotonStyle" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" Padding="8,0">
                        <TextBlock Text="{x:Static c:Iconos.Calendario}" FontFamily="{DynamicResource IconFont}"
                                   FontSize="{DynamicResource FsSubtitle}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource NavHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border x:Name="PART_Root" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True"
                            CornerRadius="{DynamicResource RadSm}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <p:DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0" />

                            <Button x:Name="PART_Button" Grid.Column="1"
                                    Style="{StaticResource DatePickerBotonStyle}" />

                            <Popup x:Name="PART_Popup" StaysOpen="False" AllowsTransparency="True"
                                   Placement="Bottom" PlacementTarget="{Binding ElementName=PART_TextBox}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Calendario ============================ -->

    <!-- Con clave, no implicito, y por una razon que cuesta encontrar: CalendarItem crea los
         botones de dia enlazando su Style a Calendar.CalendarDayButtonStyle. Ese enlace deja un
         valor local en la propiedad Style aunque el origen sea nulo, y un Style local a nulo
         IMPIDE que WPF busque el estilo implicito. Resultado: la plantilla de fabrica, con su
         gris #333333 escrito a fuego, sobre el fondo oscuro. Hay que darselo por la propiedad
         del Calendar (mas abajo), que es el enganche que WPF si respeta. -->
    <Style x:Key="DiaCalendarioStyle" TargetType="CalendarDayButton">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource RadSm}" Margin="1">
                        <TextBlock x:Name="Numero" Text="{TemplateBinding Content}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter TargetName="Numero" Property="Foreground"
                                    Value="{DynamicResource TextMutedBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource NavHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource AccentBlueBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <!-- PrimaryButtonBrush y no AccentBlueBrush: el número lleva OnAccentBrush
                             encima, y en la paleta clara AccentBlueBrush (el escalón intermedio de
                             borde/foco) solo da 3,44:1 como relleno de texto — por debajo de AA. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource PrimaryButtonBrush}" />
                            <Setter TargetName="Numero" Property="Foreground"
                                    Value="{DynamicResource OnAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Los botones de mes y de anno, tanto en la cabecera como en las vistas de anno y decada. -->
    <Style x:Key="MesCalendarioStyle" TargetType="CalendarButton">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="MinWidth" Value="42" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource RadSm}" Margin="1">
                        <TextBlock x:Name="Etiqueta" Text="{TemplateBinding Content}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource NavHoverBrush}" />
                        </Trigger>
                        <Trigger Property="HasSelectedDays" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource NavSelectedBrush}" />
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter TargetName="Etiqueta" Property="Foreground"
                                    Value="{DynamicResource TextMutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CalendarNavegarStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource RadSm}" Padding="6,3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource NavHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CalendarItem">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarItem">
                    <ControlTemplate.Resources>
                        <DataTemplate x:Key="{x:Static p:CalendarItem.DayTitleTemplateResourceKey}">
                            <TextBlock Text="{Binding}" FontSize="{DynamicResource FsMicro}" FontWeight="{DynamicResource FwMedium}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,0,0,4"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadMd}" Padding="8" Margin="0,0,8,8"
                            Effect="{DynamicResource SombraFlotante}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="PART_PreviousButton" Grid.Column="0"
                                        Style="{StaticResource CalendarNavegarStyle}"
                                        FontFamily="{DynamicResource IconFont}"
                                        Content="{x:Static c:Iconos.ChevronIzquierda}" FontSize="{DynamicResource FsBody}" />

                                <Button x:Name="PART_HeaderButton" Grid.Column="1"
                                        Style="{StaticResource CalendarNavegarStyle}"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        FontWeight="{DynamicResource FwMedium}" FontSize="{DynamicResource FsBody}" />

                                <Button x:Name="PART_NextButton" Grid.Column="2"
                                        Style="{StaticResource CalendarNavegarStyle}"
                                        FontFamily="{DynamicResource IconFont}"
                                        Content="{x:Static c:Iconos.ChevronDerecha}" FontSize="{DynamicResource FsBody}" />
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid x:Name="PART_MonthView" Visibility="Visible">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                </Grid>

                                <Grid x:Name="PART_YearView" Visibility="Hidden">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Calendar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource DiaCalendarioStyle}" />
        <Setter Property="CalendarButtonStyle" Value="{StaticResource MesCalendarioStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Calendar">
                    <StackPanel x:Name="PART_Root" HorizontalAlignment="Center">
                        <p:CalendarItem x:Name="PART_CalendarItem" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Emergentes ============================ -->

    <!-- El hueco entre la barra de scroll vertical y la horizontal lo pinta la plantilla de
         fabrica del ScrollViewer con este brush del sistema, y lo hace por DynamicResource:
         se puede sustituir por clave desde aqui. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent" />

    <Style TargetType="ToolTip">
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>

</ResourceDictionary>
