<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:ASO_PRODUCS.Desktop.ViewModels"
                    xmlns:views="clr-namespace:ASO_PRODUCS.Desktop.Views">

  <!-- Que pantalla dibuja cada ViewModel. MainWindow asigna el ViewModel al ContentControl y
       WPF resuelve la vista por aqui, igual que CrudEditorWindow hace con los editores en
       EditorTemplates.xaml. Una pantalla nueva se registra en dos sitios: la tabla Pantallas
       de MainWindow.xaml.cs y esta lista. Si falta la plantilla se nota al instante: el area
       de contenido muestra el nombre del tipo del ViewModel en vez de la pantalla. -->

  <!-- Plantilla de ejemplo (Finanzas · Cuentas por Pagar y Movimientos) -->

  <DataTemplate DataType="{x:Type vm:MovimientosViewModel}">
    <views:MovimientosView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:CuentasPorPagarViewModel}">
    <views:CuentasPorPagarView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:CuentasPorCobrarViewModel}">
    <views:CuentasPorCobrarView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:ProveedoresViewModel}">
    <views:ProveedoresView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:ClientesViewModel}">
    <views:ClientesView />
  </DataTemplate>

  <!-- Inventario · Almacén, Entradas y Salidas -->

  <DataTemplate DataType="{x:Type vm:AlmacenViewModel}">
    <views:AlmacenView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:EntradasViewModel}">
    <views:EntradasView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:SalidasViewModel}">
    <views:SalidasView />
  </DataTemplate>

  <!-- Materia Prima · Existencias, Recepciones y Salidas -->

  <DataTemplate DataType="{x:Type vm:ExistenciasMateriaPrimaViewModel}">
    <views:ExistenciasMateriaPrimaView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:RecepcionesMateriaPrimaViewModel}">
    <views:RecepcionesMateriaPrimaView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:SalidasMateriaPrimaViewModel}">
    <views:SalidasMateriaPrimaView />
  </DataTemplate>

  <!-- Procesos · Producción y Despacho -->

  <DataTemplate DataType="{x:Type vm:ProcesosProduccionViewModel}">
    <views:ProcesosProduccionView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:DespachosViewModel}">
    <views:DespachosView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:PedidosViewModel}">
    <views:PedidosView />
  </DataTemplate>

  <!-- Reportes: Procesos, Ventas, Gastos y Cartera -->

  <DataTemplate DataType="{x:Type vm:ReporteProcesosViewModel}">
    <views:ReporteProcesosView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:ReporteVentasViewModel}">
    <views:ReporteVentasView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:ReporteGastosViewModel}">
    <views:ReporteGastosView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:ReporteCarteraViewModel}">
    <views:ReporteCarteraView />
  </DataTemplate>

  <!-- Armazón -->

  <DataTemplate DataType="{x:Type vm:AdministracionViewModel}">
    <views:AdministracionView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:PeticionesViewModel}">
    <views:PeticionesView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:ConfiguracionViewModel}">
    <views:ConfiguracionView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:SubmoduloViewModel}">
    <views:SubmoduloView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:InicioViewModel}">
    <views:InicioView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:ModuloDashboardViewModel}">
    <views:ModuloDashboardView />
  </DataTemplate>

</ResourceDictionary>
